    local text = table.remove(pending)
    for name in text:gmatch("detect['\"]?%)?%.([%w_]+)") do
      if not seen[name] and type(detect[name]) == "function" then
        seen[name] = true
        local source = lines_of(detect[name])
        body = body .. "\n" .. source
        table.insert(pending, source)
      end
    end
  end
  return body
end
local function scan(kind, key, value)
  local f = type(value) == "table" and value[1] or value
  if type(f) == "function" then
    local found = {}
    for word in words(f, 0):gmatch("['\"]([%w_]+)['\"]") do found[word] = true end
