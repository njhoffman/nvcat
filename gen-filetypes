def nvcat_module():
  loader = importlib.machinery.SourceFileLoader("nvcat_script", str(ROOT / "nvcat_cli.py"))
  spec = importlib.util.spec_from_loader(loader.name, loader)
  module = importlib.util.module_from_spec(spec)
  loader.exec_module(module)
  return module


def inventory(samples):
  """Syntax files, bat-covered filetypes, and the filetype registry, from nvcat's isolated Neovim."""
  nvcat = nvcat_module()
  settings = config.load()[0]
  paths = nvcat.find_paths(settings)
  with tempfile.TemporaryDirectory(prefix="nvcat-", dir="/tmp") as temporary:
    script = Path(temporary) / "inventory.lua"
    script.write_text(INVENTORY)
    env = nvcat.isolated_environment(temporary)
    env["NVCAT_SESSION"] = json.dumps({"paths": paths, "samples": samples})
    command = nvcat.nvim_command(settings["nvim"], "--headless", "-c", f"luafile {script}", "-c", "qa!")
    result = subprocess.run(command, cwd=temporary, env=env, capture_output=True, text=True, timeout=120)
  try:
    return json.loads(result.stdout), subprocess.run([settings["nvim"], "--version"], capture_output=True,
                                                     text=True).stdout.split("\n", 1)[0]
  except ValueError:
    raise SystemExit(f"gen-filetypes: Neovim failed: {result.stderr.strip() or result.returncode}") from None


def lua_glob(pattern):
  """A glob for a Lua filetype pattern built only from literals, escapes, .* and anchors; else None.

  Returns (kind, glob) where kind is 'names' for basename patterns and 'paths' for patterns with a '/'."""
  anchored_start = pattern.startswith("^")
  body = pattern[1:] if anchored_start else pattern
  anchored_end = body.endswith("$") and not body.endswith("%$")
  body = body[:-1] if anchored_end else body
  glob, index = "", 0
  while index < len(body):
    character = body[index]
    if character == "%":
      escaped = body[index + 1:index + 2]
      if not escaped or escaped.isalnum() or escaped in "*?[":
        return None
      glob += escaped
      index += 2
    elif body.startswith(".*", index):
      glob += "*"
      index += 2
    elif character in ".[]()+-?*^$":
      return None
    else:
      glob += character
      index += 1
  if len(glob.replace("*", "").replace("/", "")) < 3:
    return None
  if "/" in glob:
    if not anchored_start:
      glob = "*" + glob if glob.startswith("/") else "*/" + glob
    return "paths", glob if anchored_end else glob + "*"
  return "names", ("" if anchored_start else "*") + glob + ("" if anchored_end else "*")


def kept(kind, glob, bat_globs):
  """Whether a glob survives SKIP_GLOBS and bat's claims."""
  case_glob = filetypes.globs({kind: [glob]})[0].lower()
  return case_glob not in SKIP_GLOBS and not any(
    fnmatchcase(filetypes.sample(case_glob).lower(), claimed.lower()) for claimed in bat_globs)


def detected(data, ours, bat_globs):
  """"auto" entries: globs whose detection function can return one of ours, grouped by the possible results.

  File names come first, as in the static entries. Globs a filetypes.json entry matches first are left out."""
  curated = [entry for entry in filetypes.load() if not entry.get("last")]
  groups = {}
  for item in sorted(data["detectors"], key=lambda item: (item["kind"], item["key"])):
    if item["kind"] == "pattern":
      continue
    results = sorted(set(item["words"]) & ours)
    kind = "extensions" if item["kind"] == "extension" else "paths" if "/" in item["key"] else "names"
    glob = item["key"].lower() if kind == "extensions" else item["key"]
    if results and kept(kind, glob, bat_globs) and not filetypes.detect(
        filetypes.sample(filetypes.globs({kind: [glob]})[0]), curated):
      globs = groups.setdefault(tuple(results), {"names": [], "paths": [], "extensions": []})[kind]
      if glob not in globs:
        globs.append(glob)
  specific, extensions = [], []
  for results, globs in sorted(groups.items()):
    if globs["names"] or globs["paths"]:
      specific.append({"filetype": filetypes.AUTO, "detect": list(results),
                       **{kind: globs[kind] for kind in ("names", "paths") if globs[kind]}})
    if globs["extensions"]:
      extensions.append({"filetype": filetypes.AUTO, "detect": list(results), "extensions": globs["extensions"]})
  return specific, extensions


def build(data, bat_names, bat_globs):
  """Return (entries, rows, auto): entries in match order, rows for SYNTAX.md sorted by filetype, and the
  "auto" entries among the entries."""
  curated = {entry["filetype"] for entry in filetypes.load()}
  covered = set(data["covered"]) | {name.lower() for name in bat_names}
  candidates = {filetype for filetype, info in data["syntax"].items()
                if not info["treesitter"] and filetype not in curated
                and (filetype not in covered or filetype in NOT_COVERED)}
  found = {}
  for item in sorted(data["registry"], key=lambda item: (item["kind"], item["key"])):
    filetype = item["filetype"]
    if filetype not in candidates or item["priority"] < 0:
      continue
    if item["kind"] == "extension":
      kind, glob = "extensions", item["key"].lower()
    elif item["kind"] == "filename":
      kind, glob = ("paths", item["key"]) if "/" in item["key"] else ("names", item["key"])
    else:
      converted = lua_glob(item["key"])
      if converted is None:
        continue
      kind, glob = converted
    if not kept(kind, glob, bat_globs):
      continue
    globs = found.setdefault(filetype, {"extensions": [], "names": [], "paths": []})
    if glob.lower() not in [existing.lower() for existing in globs[kind]]:
      globs[kind].append(glob)
  # Neovim checks file names and patterns before extensions, so specific entries come first: a filetype's
  # names/paths entry precedes every extension entry (e.g. /etc/a2ps.cfg before another filetype's *.cfg).
  specific, extensions, rows = [], [], []
  for filetype in sorted(found):
    globs = found[filetype]
    if globs["names"] or globs["paths"]:
      specific.append({"filetype": filetype, **{key: globs[key] for key in ("names", "paths") if globs[key]}})
    if globs["extensions"]:
      extensions.append({"filetype": filetype, "extensions": globs["extensions"]})
    source = data["syntax"][filetype]["file"]
    rows.append((filetype, filetypes.globs(globs), "" if "/runtime/syntax/" in source else source))
  # A detection function can also return a filetypes.json filetype; nvcat renders those too.
  auto_names, auto_extensions = detected(data, candidates | curated, bat_globs)
  return specific + auto_names + extensions + auto_extensions, rows, auto_names + auto_extensions


def table(rows, auto, nvim_version, bat_version):
  def shown(patterns):
    patterns = [pattern[2:] if pattern.startswith("*/") and "/" not in pattern[2:] else pattern
                for pattern in patterns]
    unique = list(dict.fromkeys(patterns))
    return ", ".join(f"`{pattern}`" for pattern in unique[:6]) + (f", {len(unique) - 6} more"
                                                                  if len(unique) > 6 else "")
  lines = [
    START,
    "",
    f"Generated by `./gen-filetypes` against Neovim `{nvim_version.split()[-1]}` and bat {bat_version}: "
    f"{len(rows)} filetypes. Source is empty for Neovim's own runtime files.",
    "",
    "| Filetype | Matches | Source |",
    "|---|---|---|",
  ]
  for filetype, patterns, source in rows:
    lines.append(f"| `{filetype}` | {shown(patterns)} | {f'`{source}`' if source else ''} |")
  lines += [
    "",
    f"Detected by content ({sum(len(filetypes.globs(entry)) for entry in auto)} globs): nvcat-dispatch "
    "sends these to `nvcat --filetype auto`, which renders Neovim's choice when it is one of the filetypes "
    "below and hands any other result to bat.",
    "",
    "| Matches | Neovim may detect |",
    "|---|---|",
  ]
  for entry in auto:
    lines.append(f"| {shown(filetypes.globs(entry))} | {', '.join(f'`{name}`' for name in entry['detect'])} |")
  return "\n".join(lines + ["", END])


def normalized(name):
  return re.sub(r"[^a-z0-9]", "", name.lower())


def bat_covers(data, bat_names):
  """Whether bat has a syntax for a Neovim filetype: by name (see BAT_ALIASES), or by one of bat's file names
  or extensions that Neovim detects as the filetype; NOT_COVERED overrides both."""
  names = {normalized(name) for name in bat_names}
  names |= {normalized(inner) for name in bat_names for inner in re.findall(r"\(([^)]+)\)", name)}
  names |= {normalized(filetype) for filetype, syntax in BAT_ALIASES.items() if syntax in bat_names}
  detected = set(data["covered"])
  return lambda filetype: filetype not in NOT_COVERED and (filetype in detected or normalized(filetype) in names)


FILES_NOTE = ("\"Files\" lists up to six extensions (`.ext`) and file names that Neovim's filetype registry "
              "(`vim.filetype.inspect()`) or nvcat's filetypes.json gives the filetype, including those where a "
              "Neovim detection function decides by content, plus a count of path patterns. \"Detected at "
              "runtime\" means only a pattern function gives it.")


def prose(text, width=110):
  return textwrap.wrap(text, width, break_on_hyphens=False)


def pools(data, bat_names):
  """The two SYNTAX.md sections listing what Neovim highlights and bat does not: (Tree-sitter, regex)."""
  covers = bat_covers(data, bat_names)
  files, runtime = {}, set()  # files: filetype -> [{lowercase glob: shown glob}, pattern count]

  def add(filetype, glob):
    """glob: ("ext", extension) or ("name", file name or path); case variants collapse to the lowercase one."""
    kind, text = glob
    key = (kind, text.lower())
    globs = files.setdefault(filetype, [{}, 0])[0]
    if key not in globs or text.islower():
      globs[key] = glob

  for item in data["registry"]:
    if item["kind"] == "pattern":
      files.setdefault(item["filetype"], [{}, 0])[1] += 1
    else:
      add(item["filetype"], ("ext", item["key"]) if item["kind"] == "extension" else ("name", item["key"]))
  for item in data["detectors"]:
    runtime.update(item["words"])
    if item["kind"] != "pattern":
      for word in item["words"]:
        if word in data["syntax"] or any(word in info["filetypes"] for info in data["parsers"].values()):
          add(word, ("ext", item["key"]) if item["kind"] == "extension" else ("name", item["key"]))
  for entry in filetypes.load():  # nvcat's own table maps some filetypes Neovim does not know by name
    for extension in entry.get("extensions", []):
      add(entry["filetype"], ("ext", extension))
    for glob in entry.get("names", []) + entry.get("paths", []):
      add(entry["filetype"], ("name", glob))

  def has_files(filetype):
    return filetype in files or filetype in runtime

  def shown(names):
    globs, patterns = {}, 0
    for filetype in names:
      globs.update(files.get(filetype, [{}, 0])[0])
      patterns += files.get(filetype, [{}, 0])[1]
    if not globs and not patterns:
      return "detected at runtime"
    # Extensions first, then names and paths, each sorted.
    globs = [f".{text}" if kind == "ext" else text
             for kind, text in sorted(globs.values(), key=lambda glob: (glob[0], glob[1].lower()))]
    parts = [f"`{glob}`" for glob in globs[:6]] + ([f"{len(globs) - 6} more"] if len(globs) > 6 else [])
    parts += [f"{patterns} pattern{'s' if patterns > 1 else ''}"] if patterns else []
    return ", ".join(parts)

  parsers = {}
  for lang, info in data["parsers"].items():
    names = list(dict.fromkeys(info["filetypes"] + PARSER_FILETYPES.get(lang, [])))
    parsers[lang] = (names, info["highlights"])
  parser_of = {}
  for lang, (names, _) in sorted(parsers.items()):
    for filetype in names:
      parser_of.setdefault(filetype, lang)
  uncovered = {lang: value for lang, value in parsers.items() if not any(covers(name) for name in value[0])}
  header = ["| Parser | Neovim filetypes | Files | Notes |", "|---|---|---|---|"]
  with_files, without = [], []
  for lang in sorted(uncovered):
    names, highlights = uncovered[lang]
    row = (f"| `{lang}` | {', '.join(names)} | {shown(names)} | "
           f"{'' if highlights else 'no highlights query installed'} |")
    (with_files if any(has_files(name) for name in names) else without).append(row)
  treesitter = [
    "## Neovim treesitter filetypes not in bat",
    "",
    *prose(f"Covers the Tree-sitter parsers on nvcat's runtimepath. A parser counts as covered by bat when bat "
           "has a syntax for one of the parser's filetypes, by name or by a file extension or name that Neovim "
           f"maps to that filetype. {len(parsers) - len(uncovered)} parsers are covered; the {len(with_files)} "
           f"below are not, plus {len(without)} with no file mapping. Extension collisions such as `.fsh` (GLSL "
           "shader vs. FHIR Shorthand), `.v` (Verilog vs. V), `.ad` (AsciiDoc vs. X app-defaults) and "
           "`*.css.liquid` do not count as coverage (`NOT_COVERED` in `gen-filetypes`). A parser's filetypes "
           "include those nvim-treesitter registers for it."),
    "",
    *prose(FILES_NOTE + " \"No highlights query installed\" means the parser exists but Neovim has no "
           "Tree-sitter highlighting for it; Neovim may still highlight that filetype with a regex syntax file "
           "(see the next section)."),
    "",
    *header, *with_files,
    "",
    "### Parsers with no file mapping",
    "",
    *prose("No file name, extension, pattern or detection function in nvcat's Neovim gives these parsers' "
           "filetypes. Most highlight regions inside other languages (comments, doc comments, regex and format "
           "strings, inline Markdown) or Neovim-internal buffers; the rest are languages whose files only a "
           "plugin detects. To render one with nvcat, add it to filetypes.json or pass `--filetype`."),
    "",
    *header, *without,
  ]
  syntaxes = sorted(set(data["syntax"]) - HELPERS)
  regex_uncovered = [name for name in syntaxes if not covers(name)]
  file_rows, buffer_rows = [], []
  for name in regex_uncovered:
    lang = parser_of.get(name, "")
    parser = f"`{lang}`" if lang else ""
    if has_files(name):
      file_rows.append(f"| `{name}` | {shown([name])} | {parser} |")
    else:
      buffer_rows.append(f"| `{name}` | {parser} |")
  regex = [
    "## Neovim regex syntax filetypes not in bat",
    "",
    *prose(f"Covers every `syntax/*.vim` file on nvcat's runtimepath (Neovim's own runtime; plugins and the "
           f"user's config are not loaded). {len(syntaxes)} filetypes have a regex syntax file (helper files "
           f"such as `syncolor` and `2html` are excluded); {len(syntaxes) - len(regex_uncovered)} are covered by "
           f"bat under the same rules as above, and the {len(regex_uncovered)} below are not. Hand review dropped "
           "false matches including `atlas` (`.as`), `cobol` (`.cpy`), `progress` (`.p`), `lex` (`.l`), "
           "`lifelines` (`.ll`), `inform` (`.inf`), `pov` (`.inc`), `tads` (`.t`) and `st` (`.cls`); the "
           "generic `conf` filetype is not covered by bat's DotENV syntax either."),
    "",
    *prose("Caveat: coverage was checked through Neovim's detection of bat's file names and extensions. Where "
           "Neovim detects a filetype only by full path (systemd units), a bat match can be missed; "
           "`gen-dispatch` checks bat's own patterns directly and is authoritative for routing."),
    "",
    *prose(FILES_NOTE + " \"Tree-sitter parser\" names the installed parser for the same filetype, if any."),
    "",
    "### File types",
    "",
    "| Filetype | Files | Tree-sitter parser |",
    "|---|---|---|",
    *file_rows,
    "",
    "### Editor buffers and include-only syntaxes",
    "",
    *prose("These have a syntax file but nothing in Neovim's filetype registry gives them: editor UI buffers "
           "(`qf`), syntaxes only included by other syntaxes, and filetypes set only by a modeline, shebang, or "
           "plugin."),
    "",
    "| Filetype | Tree-sitter parser |",
    "|---|---|",
    *buffer_rows,
  ]
  return "\n".join(treesitter + [""] + regex), len(parsers)


def replace_block(document, markers, body):
  start, end = markers
  if start not in document:
    raise SystemExit(f"gen-filetypes: no {start} block in SYNTAX.md")
  before, rest = document.split(start, 1)
  return before + start + "\n" + body + "\n" + end + rest.split(end, 1)[1]


def highlighted(data):
  """Filetypes with a syntax file or a parser that has a highlights query, sorted."""
  names = set(data["syntax"])
  for info in data["parsers"].values():
    if info["highlights"]:
      names.update(info["filetypes"])
  return sorted(name for name in names if re.match(filetypes.FILETYPE_NAME, name))


def main():
  parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
  parser.add_argument("--output", default=str(filetypes.GENERATED), help="JSON file to write, or - for stdout")
  parser.add_argument("--no-docs", action="store_true", help="Leave SYNTAX.md alone")
  parser.add_argument("--syntax", type=Path, default=SYNTAX_MD,
                      help="SYNTAX.md to update in place (default: the checkout's)")
  args = parser.parse_args()
  bat_version, patterns = filetypes.bat_patterns()
  bat_globs = sorted({glob for _, glob in patterns})
  bat_names = sorted({syntax for syntax, _ in patterns})
  samples = sorted({filetypes.sample(glob) for glob in bat_globs})
  data, nvim_version = inventory(samples)
  entries, rows, auto = build(data, bat_names, bat_globs)
  document = {
    "description": "Generated by ./gen-filetypes; do not edit. Neovim regex-syntax filetypes that bat has no "
                   "syntax for, checked after filetypes.json (before its 'last' entries). Same keys as "
                   "filetypes.json, plus 'auto' entries: globs Neovim detects by content, where 'detect' "
                   "lists the results nvcat renders. 'highlighted': every filetype nvcat's Neovim can "
                   "highlight (a syntax file, or a Tree-sitter parser with a highlights query), which a "
                   "modeline may name.",
    "filetypes": entries,
  }
  names = highlighted(data)
  text = ("{\n  \"description\": " + json.dumps(document["description"]) + ",\n  \"filetypes\": [\n"
          + ",\n".join("    " + json.dumps(entry, ensure_ascii=False) for entry in entries) + "\n  ],\n"
          + "  \"highlighted\": [\n" + "\n".join(textwrap.wrap(", ".join(json.dumps(name) for name in names),
                                                             width=110, initial_indent="    ",
                                                             subsequent_indent="    ", break_on_hyphens=False))
          + "\n  ]\n}\n")
  if args.output == "-":
    sys.stdout.write(text)
  else:
    Path(args.output).write_text(text)
    print(f"Wrote {args.output} ({len(rows)} filetypes, {len(entries)} entries)", file=sys.stderr)
  if not args.no_docs:
    document = args.syntax.read_text()
    if START not in document:
      raise SystemExit(f"gen-filetypes: no {START} block in SYNTAX.md")
    before, rest = document.split(START, 1)
    after = rest.split(END, 1)[1]
    document = before + table(rows, auto, nvim_version, bat_version) + after
    body, parser_count = pools(data, bat_names)
    document = replace_block(document, POOLS, body)
    summary = (f"Generated by `./gen-filetypes` against Neovim `{nvim_version.split()[-1]}`, bat {bat_version} "
               f"({len(bat_names)} syntaxes, including\nthe `--map-syntax` entries in the bat config), and the "
               f"{parser_count} Tree-sitter parsers on nvcat's runtimepath.")
    args.syntax.write_text(replace_block(document, SUMMARY, summary))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
