INVENTORY = r"""
local s = vim.json.decode(vim.env.NVCAT_SESSION)
nvcat.setup(nil, s.paths)
local out = { syntax = {}, covered = {}, registry = {}, detectors = {} }
for _, file in ipairs(vim.api.nvim_get_runtime_file("syntax/*.vim", true)) do
  local ft = vim.fn.fnamemodify(file, ":t:r")
  if out.syntax[ft] == nil then
    local lang = vim.treesitter.language.get_lang(ft) or ft
    local ok, loaded = pcall(vim.treesitter.language.add, lang)
    local highlights = ok and loaded == true and #vim.treesitter.query.get_files(lang, "highlights") > 0
    out.syntax[ft] = { file = file, treesitter = highlights and lang or vim.NIL }
  end
end
for _, sample in ipairs(s.samples) do
  local ok, ft = pcall(vim.filetype.match, { filename = sample })
  if ok and type(ft) == "string" then
    out.covered[ft] = true
  end
end
local function add(kind, key, value)
  local ft, priority = value, 0
  if type(value) == "table" then
    ft, priority = value[1], (value[2] or {}).priority or 0
  end
  if type(ft) == "string" then
    table.insert(out.registry, { kind = kind, key = key, filetype = ft, priority = priority })
  end
end
-- The quoted words in a detection function's source, following detect.* calls and string or function
-- upvalues (Neovim wraps most detectors in a closure over the detector's name).
local detect = require("vim.filetype.detect")
local function lines_of(f)
  local info = debug.getinfo(f, "S")
  local path = info.source:sub(2)
  if vim.fn.filereadable(path) == 0 then
    path = vim.api.nvim_get_runtime_file("lua/" .. path:gsub("%.lua$", "") .. ".lua", false)[1]
  end
  if info.what ~= "Lua" or not path or vim.fn.filereadable(path) == 0 then
    return ""
  end
  return table.concat(vim.list_slice(vim.fn.readfile(path), info.linedefined, info.lastlinedefined), "\n")
end
local function words(f, depth)
  local body = lines_of(f)
  for index = 1, 20 do
    local name, value = debug.getupvalue(f, index)
    if name == nil then break end
    -- A string upvalue is a detector's name or a result ('dcl' in detect_seq(detect.bindzone, 'dcl')).
    -- Tables: only short argument lists ({...} in detect_seq), not the filetype maps that suffix-stripping
    -- detectors (*.bak, *.orig) close over.
    local values = { value }
    if type(value) == "table" then
      values = vim.islist(value) and #value <= 8 and value or {}
    end
    for _, item in ipairs(values) do
      if type(item) == "string" then body = body .. "\ndetect." .. item .. " '" .. item .. "'" end
      if type(item) == "function" and depth < 2 then body = body .. "\n" .. words(item, depth + 1) end
