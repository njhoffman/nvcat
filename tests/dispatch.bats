#!/usr/bin/env bats
# Routing in the generated nvcat-dispatch, and its agreement with filetypes.py.

bats_require_minimum_version 1.5.0

setup() {
  ROOT=$(cd "$BATS_TEST_DIRNAME/.." && pwd)
  DISPATCH=$ROOT/nvcat-dispatch
  FIXTURES=$BATS_TEST_DIRNAME/fixtures
  STUBS=$BATS_TEST_TMPDIR/stubs
  mkdir -p "$STUBS"
  printf '#!/bin/sh\necho "nvcat $*"\n' > "$STUBS/nvcat-ok"
  printf '#!/bin/sh\necho partial; echo boom >&2; exit 1\n' > "$STUBS/nvcat-fail"
  printf '#!/bin/sh\necho "bat $*"\n' > "$STUBS/bat"
  chmod +x "$STUBS"/*
}

route() {
  run "$DISPATCH" --print "$@"
}

@test "the generated script and bat's claims are not tracked, and the suite generates them" {
  for file in nvcat-dispatch filetypes.bat.json; do
    git -C "$ROOT" check-ignore -q "$file" || { echo "$file is not ignored"; return 1; }
    [ -z "$(git -C "$ROOT" ls-files -- "$file")" ] || { echo "$file is tracked"; return 1; }
    [ -s "$ROOT/$file" ] || { echo "$file was not generated (tests/setup_suite.bash)"; return 1; }
  done
  run diff <("$ROOT/gen-dispatch" --output - --claims -) "$DISPATCH"
  [ "$status" -eq 0 ]
}

@test "gen-dispatch is reproducible" {
  "$ROOT/gen-dispatch" --output "$BATS_TEST_TMPDIR/a" --claims "$BATS_TEST_TMPDIR/a.json" 2>/dev/null
  "$ROOT/gen-dispatch" --output "$BATS_TEST_TMPDIR/b" --claims "$BATS_TEST_TMPDIR/b.json" 2>/dev/null
  cmp "$BATS_TEST_TMPDIR/a" "$BATS_TEST_TMPDIR/b"
  cmp "$BATS_TEST_TMPDIR/a.json" "$BATS_TEST_TMPDIR/b.json"
}

@test "without bat, gen-dispatch writes a router with no bat claims and says why" {
  # A PATH without bat: gen-dispatch runs bat by name.
  mkdir -p "$BATS_TEST_TMPDIR/empty"
  run --separate-stderr env PATH="$BATS_TEST_TMPDIR/empty" "$(command -v python3)" "$ROOT/gen-dispatch" \
    --output "$BATS_TEST_TMPDIR/dispatch" --claims "$BATS_TEST_TMPDIR/claims.json"
  [ "$status" -eq 0 ]
  [[ $stderr == *"bat is not installed"* ]]
  grep -q '^# Generated by ./gen-dispatch .* and bat (not installed)\.' "$BATS_TEST_TMPDIR/dispatch"
  ! grep -q '# bat: ' "$BATS_TEST_TMPDIR/dispatch"
  [ "$(python3 -c 'import json, sys; print(len(json.load(open(sys.argv[1]))["claims"]))' "$BATS_TEST_TMPDIR/claims.json")" = 0 ]
  run "$BATS_TEST_TMPDIR/dispatch" --print -- "$FIXTURES/markdown/sample.md"
  [ "$output" = markdown ]
}

@test "just install generates the router before checking and linking" {
  command -v just >/dev/null || skip "just is not installed"
  run just --justfile "$ROOT/justfile" --dry-run install
  [ "$status" -eq 0 ]
  [[ $output == *"./gen-dispatch"*"nvcat --check"*"ln -sfn"* ]]
}

@test "nvcat --check reports a missing or stale router" {
  run python3 - "$ROOT" "$BATS_TEST_TMPDIR/checkout" <<'PY'
import importlib.machinery, importlib.util, os, shutil, sys
from pathlib import Path
root, checkout = Path(sys.argv[1]), Path(sys.argv[2])
sys.path.insert(0, str(root))
loader = importlib.machinery.SourceFileLoader("nvcat_script", str(root / "nvcat_cli.py"))
nvcat = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(nvcat)
checkout.mkdir()
for name in nvcat.DISPATCH_INPUTS:
  shutil.copy(root / name, checkout / name)
print(nvcat.dispatch_problem(checkout))
(checkout / "nvcat-dispatch").write_text("#!/bin/sh\n")
print(nvcat.dispatch_problem(checkout))
later = (checkout / "nvcat-dispatch").stat().st_mtime + 10
os.utime(checkout / "filetypes.json", (later, later))
print(nvcat.dispatch_problem(checkout))
PY
  [ "$status" -eq 0 ]
  [ "${lines[0]}" = 'nvcat-dispatch is not generated: run `just dispatch` (`just install` does too)' ]
  [ "${lines[1]}" = None ]
  [ "${lines[2]}" = 'nvcat-dispatch is older than filetypes.json: run `just dispatch`' ]
}

@test "every filetype entry has a fixture that routes to it" {
  missing=$(python3 -c '
import sys; sys.path.insert(0, sys.argv[1]); import filetypes
print(" ".join(e["filetype"] for e in filetypes.load()))' "$ROOT")
  for filetype in $missing; do
    [ -d "$FIXTURES/$filetype" ] || { echo "no fixture directory for $filetype"; return 1; }
  done
}

@test "fixtures route to the filetype named by their directory" {
  while IFS= read -r file; do
    expected=${file#"$FIXTURES"/}
    expected=${expected%%/*}
    case $expected in bat | reference) continue ;; esac  # reference/: Markdown documents, not a filetype
    case $file in */plain.html | */nochart/* | */Chart.yaml) continue ;; esac
    route "$file"
    [ "$status" -eq 0 ] || { echo "$file: not routed"; return 1; }
    [ "$output" = "$expected" ] || { echo "$file: got $output, expected $expected"; return 1; }
  done < <(find "$FIXTURES" -type f | sort)
}

@test "Markdown extensions match case-insensitively" {
  cp "$FIXTURES/markdown/sample.md" "$BATS_TEST_TMPDIR/UPPER.MD"
  route "$BATS_TEST_TMPDIR/UPPER.MD"
  [ "$output" = markdown ]
}

@test "relative paths match path globs" {
  cd "$FIXTURES/kitty"
  route kitty/kitty.conf
  [ "$output" = kitty ]
  cd "$FIXTURES/helm/chart"
  route templates/deployment.yaml
  [ "$output" = helm ]
}

@test "helm needs Chart.yaml above templates/" {
  route "$FIXTURES/helm/nochart/templates/plain.yaml"
  [ "$status" -eq 1 ]
}

@test "html without Django tags goes to bat" {
  route "$FIXTURES/htmldjango/plain.html"
  [ "$status" -eq 1 ]
}

@test "names bat claims go to bat even when a glob matches" {
  route "$FIXTURES/bat/nginx/nginx.conf"
  [ "$status" -eq 1 ]
}

@test "prefer_over_bat entries win over bat's patterns" {
  route "$FIXTURES/systemd/app.service"
  [ "$output" = systemd ]
  route "$FIXTURES/markdown/sample.md"
  [ "$output" = markdown ]
}

@test "languages bat has go to bat" {
  route "$FIXTURES/bat/script.py"
  [ "$status" -eq 1 ]
}

@test "missing files and directories go to bat" {
  route "$BATS_TEST_TMPDIR/missing.md"
  [ "$status" -eq 1 ]
  mkdir "$BATS_TEST_TMPDIR/dir.md"
  route "$BATS_TEST_TMPDIR/dir.md"
  [ "$status" -eq 1 ]
}

@test "filenames with spaces and leading dashes" {
  cp "$FIXTURES/markdown/sample.md" "$BATS_TEST_TMPDIR/-a b.md"
  NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat run "$DISPATCH" "$BATS_TEST_TMPDIR/-a b.md"
  [ "$output" = "nvcat --all --paging=never --budget=2 --filetype markdown -- $BATS_TEST_TMPDIR/-a b.md" ]
}

@test "-- ends the options, so a file can be named --print or --" {
  cd "$BATS_TEST_TMPDIR"
  cp "$FIXTURES/markdown/sample.md" ./--print
  NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat run "$DISPATCH" -- --print
  [ "$status" -eq 0 ]
  [[ $output == "bat --color=always "*"--paging=never -- --print" ]]
  route -- "$FIXTURES/tmux/.tmux.conf"
  [ "$output" = tmux ]
  run "$DISPATCH" --print -- --print
  [ "$status" -eq 1 ]
  cp "$FIXTURES/markdown/sample.md" ./--
  run "$DISPATCH" --print -- --
  [ "$status" -eq 1 ]
  run "$DISPATCH" -- a b
  [ "$status" -eq 2 ]
}

@test "routed files call nvcat with the filetype" {
  NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat run "$DISPATCH" "$FIXTURES/tmux/.tmux.conf"
  [ "$status" -eq 0 ]
  [ "$output" = "nvcat --all --paging=never --budget=2 --filetype tmux -- $FIXTURES/tmux/.tmux.conf" ]
}

@test "other files go to bat" {
  NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat run "$DISPATCH" "$FIXTURES/bat/script.py"
  [[ $output == "bat --color=always "*"--paging=never -- $FIXTURES/bat/script.py" ]]
}

@test "nvcat failure falls back to bat and hides nvcat stderr" {
  NVCAT=$STUBS/nvcat-fail BAT=$STUBS/bat run --separate-stderr "$DISPATCH" "$FIXTURES/kdl/config.kdl"
  [ "$status" -eq 0 ]
  [[ ${lines[-1]} == "bat --color=always "*"--paging=never -- $FIXTURES/kdl/config.kdl" ]]
  [ -z "$stderr" ]
}

@test "missing nvcat falls back to bat" {
  NVCAT=$BATS_TEST_TMPDIR/none BAT=$STUBS/bat run "$DISPATCH" "$FIXTURES/kdl/config.kdl"
  [[ $output == "bat --color=always "*"--paging=never -- $FIXTURES/kdl/config.kdl" ]]
}

@test "usage errors" {
  run "$DISPATCH"
  [ "$status" -eq 2 ]
  run "$DISPATCH" a b
  [ "$status" -eq 2 ]
}

@test "filetypes.py agrees with the script on every routed fixture" {
  while IFS= read -r file; do
    route "$file"
    [ "$status" -eq 0 ] || continue
    expected=$output
    actual=$(python3 -c '
import sys; sys.path.insert(0, sys.argv[1]); import filetypes
entry = filetypes.detect(sys.argv[2]); print(entry["filetype"] if entry else "")' "$ROOT" "$file")
    [ "$actual" = "$expected" ] || { echo "$file: python $actual, bash $expected"; return 1; }
  done < <(find "$FIXTURES" -type f | sort)
}

@test "the bat branch keeps a file's and a name's escapes out of the terminal, and bat's exit status" {
  command -v bat >/dev/null || skip "bat not installed"
  evil=$BATS_TEST_TMPDIR/evil.xyzunknown
  printf 'keep \e]0;PWNED\a \e[31mred\e[0m \xc2\x9d0;C1\xc2\x9c \aBEL \ePdcs\e\\ END\n' > "$evil"
  for setting in NVCAT_COLOR=always NVCAT_COLOR=never NO_COLOR=1; do
    run --separate-stderr env "$setting" "$DISPATCH" -- "$evil"
    [ "$status" -eq 0 ] || { echo "$setting: $stderr"; return 1; }
    [[ $output == *keep* && $output == *END* ]] || { echo "$setting: $output"; return 1; }
    [[ $output != *$'\a'* && $output != *$'\xc2\x9d'* && $output != *$'\e]'* && $output != *$'\eP'* &&
      $output != *$'\e[31m'* ]] || { echo "$setting passes escapes"; return 1; }
    if [ "$setting" != NVCAT_COLOR=always ]; then
      [[ $output != *$'\e'* ]] || { echo "$setting has color"; return 1; }
    fi
  done
  run --separate-stderr env -u NO_COLOR "$DISPATCH" -- "$BATS_TEST_TMPDIR/"$'missing\e]0;PWNED\a.xyzunknown'
  [ "$status" -eq 1 ]
  [[ $stderr == *missing* && $stderr != *$'\e'* && $stderr != *$'\a'* ]]
}

@test "the bat branch picks its color from NVCAT_COLOR, then NO_COLOR, then always" {
  run env -u NO_COLOR -u NVCAT_COLOR NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat "$DISPATCH" -- "$FIXTURES/bat/script.py"
  [[ $output == "bat --color=always "* ]]
  run env -u NVCAT_COLOR NO_COLOR=1 NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat "$DISPATCH" -- "$FIXTURES/bat/script.py"
  [[ $output == "bat --color=never --decorations=always --style=plain "* ]]
  run env NO_COLOR=1 NVCAT_COLOR=always NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat "$DISPATCH" -- "$FIXTURES/bat/script.py"
  [[ $output == "bat --color=always "* ]]
  run env -u NO_COLOR NVCAT_COLOR=auto NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat "$DISPATCH" -- "$FIXTURES/bat/script.py"
  [[ $output == "bat --color=never "* ]]  # Piped, and outside fzf.
  run env -u NO_COLOR NVCAT_COLOR=auto FZF_PREVIEW_LINES=9 NVCAT=$STUBS/nvcat-ok BAT=$STUBS/bat "$DISPATCH" -- \
    "$FIXTURES/bat/script.py"
  [[ $output == "bat --color=always "* ]]
}

# Print the fastest of 20 routings of $1, in ms. Load from other processes only adds time, so the minimum stays
# meaningful on a busy machine where an average does not.
fastest_route_ms() {
  local start end took best=
  for _ in {1..20}; do
    start=${EPOCHREALTIME/[.,]/}
    "$DISPATCH" --print "$1" >/dev/null || true
    end=${EPOCHREALTIME/[.,]/}
    took=$((end - start))
    if [ -z "$best" ] || [ "$took" -lt "$best" ]; then best=$took; fi
  done
  echo $((best / 1000))
}

@test "routing is fast" {
  fastest=$(fastest_route_ms "$FIXTURES/conf/app.conf")
  echo "fastest ${fastest}ms"
  [ "$fastest" -lt 20 ]
}

@test "filetypes.regex.json and SYNTAX.md's generated sections are current with Neovim and bat" {
  cp "$ROOT/SYNTAX.md" "$BATS_TEST_TMPDIR/SYNTAX.md"
  run diff <("$ROOT/gen-filetypes" --syntax "$BATS_TEST_TMPDIR/SYNTAX.md" --output - 2>/dev/null) "$ROOT/filetypes.regex.json"
  [ "$status" -eq 0 ]
  run diff "$BATS_TEST_TMPDIR/SYNTAX.md" "$ROOT/SYNTAX.md"
  [ "$status" -eq 0 ]
}

@test "SYNTAX.md's pool sections place parsers and syntaxes by bat coverage" {
  pools=$(sed -n '/<!-- pools:start -->/,/<!-- pools:end -->/p' "$ROOT/SYNTAX.md")
  # nvim-treesitter's filetype names and bat's differently named syntaxes count as coverage.
  for covered in c_sharp tsx objc vimdoc; do
    ! grep -q "^| \`$covered\` |" <<<"$pools" || { echo "$covered listed"; return 1; }
  done
  # Hand-reviewed extension collisions do not.
  for listed in fsh v liquid; do
    grep -q "^| \`$listed\` |" <<<"$pools" || { echo "$listed missing"; return 1; }
  done
  # Globs from detection functions and from filetypes.json are listed.
  grep -q '^| `cdrtoc` | `.toc` |' <<<"$pools"
  grep -q '^| `sxhkdrc` | sxhkdrc | `\*.sxhkdrc`, `sxhkdrc` |' <<<"$pools"
}

@test "generated filetypes come after filetypes.json and before its last entries" {
  route "$FIXTURES/sysctl/etc/sysctl.d/10-net.conf"
  [ "$output" = sysctl ]
  route "$FIXTURES/conf/app.conf"
  [ "$output" = conf ]
  cp "$FIXTURES/sed/strip.sed" "$BATS_TEST_TMPDIR/STRIP.SED"
  route "$BATS_TEST_TMPDIR/STRIP.SED"
  [ "$output" = sed ]
}

@test "generated file names and paths win over generated extensions" {
  mkdir -p "$BATS_TEST_TMPDIR/etc"
  printf 'x\n' > "$BATS_TEST_TMPDIR/etc/slp.spi"
  printf 'x\n' > "$BATS_TEST_TMPDIR/page.spi"
  route "$BATS_TEST_TMPDIR/etc/slp.spi"
  [ "$output" = slpspi ]
  route "$BATS_TEST_TMPDIR/page.spi"
  [ "$output" = spyce ]
}

@test "bat keeps the globs it claims even when Neovim maps them to a generated filetype" {
  printf 'module x\n' > "$BATS_TEST_TMPDIR/go.sum"
  route "$BATS_TEST_TMPDIR/go.sum"
  [ "$status" -eq 1 ]
}

@test "filetypes.py's indexed detect agrees with fnmatch on every glob" {
  run python3 -c '
import sys; sys.path.insert(0, sys.argv[1]); import filetypes
from fnmatch import fnmatchcase
entries = filetypes.ordered()
claimed = [glob.lower() for entry in filetypes.claims() for glob in entry["paths"]]
def slow(path):
  folded = path.lower()
  if any(fnmatchcase(folded, glob) for glob in claimed):
    return None
  for entry in entries:
    if any(fnmatchcase(folded, glob.lower()) for glob in filetypes.globs(entry)) and filetypes.requirement_met(entry, path):
      return entry
paths = [filetypes.sample(glob) for entry in entries for glob in filetypes.globs(entry)]
paths += ["/a/plain.txt", "/a/b.swift.gyb", "/a/Makefile", "/a/.config/kitty/x.conf", "/a/y.conf"]
bad = [path for path in paths if filetypes.detect(path) is not slow(path)]
print(len(paths), bad[:5])
sys.exit(1 if bad else 0)' "$ROOT"
  [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "routing a file nvcat does not handle stays fast" {
  fastest=$(fastest_route_ms "$FIXTURES/bat/script.py")
  echo "fastest ${fastest}ms"
  [ "$fastest" -lt 30 ]
}

@test "content-detected globs route to auto" {
  # Pins globs found by gen-filetypes' scan of Neovim's detection functions, which a Neovim change could break.
  for name in report.w x.e x.bas x.csh .cshrc termcap xorg.conf x.y; do
    printf 'x\n' > "$BATS_TEST_TMPDIR/$name"
    route "$BATS_TEST_TMPDIR/$name"
    [ "$output" = auto ] || { echo "$name: $output"; return 1; }
  done
}

@test "auto globs leave bat's claims and filetypes.json's globs alone" {
  printf 'module x\n' > "$BATS_TEST_TMPDIR/go.mod"
  route "$BATS_TEST_TMPDIR/go.mod"
  [ "$status" -eq 1 ]
  printf '# x\n' > "$BATS_TEST_TMPDIR/notes.mkdn"
  route "$BATS_TEST_TMPDIR/notes.mkdn"
  [ "$output" = markdown ]
}

@test "auto files call nvcat with --filetype auto" {
  run env NVCAT="$STUBS/nvcat-ok" BAT="$STUBS/bat" "$DISPATCH" "$FIXTURES/auto/report.w"
  [ "$output" = "nvcat --all --paging=never --budget=2 --filetype auto -- $FIXTURES/auto/report.w" ]
}

@test "binary formats Neovim maps to a regex filetype go to bat" {
  for name in x.mo x.bc x.pdb x.class; do
    printf 'x\n' > "$BATS_TEST_TMPDIR/$name"
    route "$BATS_TEST_TMPDIR/$name"
    [ "$status" -eq 1 ] || { echo "$name: $output"; return 1; }
  done
}

# Write file $1 (in the test directory) with printf format $2.
modeline_file() {
  # shellcheck disable=SC2059
  printf -- "$2" > "$BATS_TEST_TMPDIR/$1"
}

# The filetype nvcat-dispatch --print and filetypes.detect() give file $1, which must agree: $2.
modeline_route() {
  local file=$BATS_TEST_TMPDIR/$1 shell python
  shell=$("$DISPATCH" --print -- "$file") || shell=
  python=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import filetypes
e = filetypes.detect(sys.argv[2]); print(e["filetype"] if e else "")' "$ROOT" "$file")
  [ "$shell" = "$python" ] || { echo "$1: nvcat-dispatch '$shell', filetypes.detect '$python'"; return 1; }
  [ "$shell" = "$2" ] || { echo "$1: '$shell', expected '$2'"; return 1; }
}

@test "a modeline in the first or last line names the filetype, beating the name and bat's claims" {
  modeline_file notes.txt 'hello\n\n# vim: ft=markdown\n'
  modeline_route notes.txt markdown
  modeline_file a.conf '# vim: set filetype=tmux :\nset -g x\n'
  modeline_route a.conf tmux
  modeline_file x.c '/* vim: set syn=cobol: */\nint x;\n'  # bat claims *.c
  modeline_route x.c cobol
  modeline_file page.md 'x\n<!-- vim: set ft=tmux: -->\n'  # filetypes.json's markdown entry
  modeline_route page.md tmux
}

@test "modeline forms: Vim's markers, versions, set and plain forms, ft before syn" {
  modeline_file v1.txt 'Vim: ft=markdown\n'
  modeline_route v1.txt markdown
  modeline_file v2.txt 'x\n# vim600: ft=markdown\n'
  modeline_route v2.txt markdown
  modeline_file v3.txt '\tex: ft=po\n'
  modeline_route v3.txt po
  modeline_file v4.txt '# vi:ts=4:ft=kdl:sw=2\n'
  modeline_route v4.txt kdl
  modeline_file v5.txt '# vim: syn=cweb ft=markdown\n'
  modeline_route v5.txt markdown
  modeline_file v6.txt '# vim: set ft=markdown: ft=tmux\n'  # the set form ends at the colon
  modeline_route v6.txt markdown
  modeline_file v7.txt '# vim: ft=tmux ft\n'  # a bare ft sets nothing
  modeline_route v7.txt tmux
}

@test "modelines are not found in the middle, without whitespace before the marker, or with odd names" {
  modeline_file m1.txt 'a\n# vim: ft=markdown\nb\n'
  modeline_route m1.txt ''
  modeline_file m2.txt 'index:ft=markdown\n'
  modeline_route m2.txt ''
  modeline_file m3.txt 'VIM: ft=markdown\n'
  modeline_route m3.txt ''
  modeline_file m4.txt '# vim: ft=*\n'
  modeline_route m4.txt ''
  modeline_file m5.txt '# vim: ft=$(touch pwned)\n'
  modeline_route m5.txt ''
  [ ! -e pwned ] && [ ! -e "$BATS_TEST_TMPDIR/pwned" ]
  modeline_file m6.txt ''
  modeline_route m6.txt ''
}

@test "a modeline naming a language bat would render still goes to nvcat" {
  modeline_file fzfrc '--cycle\n--ansi\n\n# vim:syn=bash:ft=\n'  # an empty ft= leaves syn=
  modeline_route fzfrc bash
  modeline_file s.sh '# vim: ft=zsh\necho\n'  # bat claims *.sh; Neovim highlights zsh
  modeline_route s.sh zsh
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import filetypes
assert "zsh" not in filetypes.accepted() and "zsh" in filetypes.highlighted()' "$ROOT"
}

@test "a modeline naming a filetype Neovim cannot highlight is ignored" {
  modeline_file r.md '# vim: ft=nosuchtype\n'
  modeline_route r.md markdown
  modeline_file both.txt '# vim: ft=nosuchtype\nx\n# vim: ft=markdown\n'  # the first is skipped, the last taken
  modeline_route both.txt markdown
}

@test "the last line: trailing blank lines, no final newline, CRLF, long files and long first lines" {
  modeline_file t1.txt 'x\n# vim: ft=markdown\n\n\n'
  modeline_route t1.txt markdown
  modeline_file t2.txt 'x\n# vim: ft=markdown'
  modeline_route t2.txt markdown
  modeline_file t3.txt 'x\r\n# vim: ft=markdown\r\n'
  modeline_route t3.txt markdown
  # Over 512 lines, and a first line of 4096+ characters: the end comes from tail instead of mapfile.
  { seq 1 600; printf '# vim: ft=markdown\n'; } > "$BATS_TEST_TMPDIR/t4.txt"
  modeline_route t4.txt markdown
  { printf '%05000d\n' 0; printf 'x\n# vim: ft=markdown\n'; } > "$BATS_TEST_TMPDIR/t5.txt"
  modeline_route t5.txt markdown
}

@test "a modeline file renders with nvcat under its filetype" {
  modeline_file notes.txt '# Title\n\nSome *text*.\n\n<!-- vim: set ft=markdown: -->\n'
  run env NVCAT="$STUBS/nvcat-ok" BAT="$STUBS/bat" "$DISPATCH" "$BATS_TEST_TMPDIR/notes.txt"
  [ "$output" = "nvcat --all --paging=never --budget=2 --filetype markdown -- $BATS_TEST_TMPDIR/notes.txt" ]
  run --separate-stderr "$ROOT/nvcat" --paging=never --columns 60 --all --timings-json "$BATS_TEST_TMPDIR/notes.txt"
  [ "$status" -eq 0 ]
  [ "$(python3 -c 'import json, sys; r = json.loads(sys.stdin.read()); print(r["filetype"], r["engine"])' <<<"$stderr")" = \
    "markdown render-markdown" ]
}

# The engine nvcat reports for file $1 rendered with the remaining arguments.
render_engine() {
  local file=$1
  shift
  run --separate-stderr "$ROOT/nvcat" --paging=never --columns 60 --all --timings-json "$@" -- "$file"
  [ "$status" -eq 0 ] || { echo "$stderr"; return 1; }
  python3 -c 'import json, sys; r = json.loads(sys.stdin.read().splitlines()[-1]); print(r["filetype"], r["engine"])' <<<"$stderr"
}

@test "a syn=-only modeline renders with the regex syntax, as Vim shows it; ft= keeps Tree-sitter" {
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import filetypes
sys.exit(0 if "bash" in filetypes.highlighted() else 1)' "$ROOT" || skip "Neovim cannot highlight bash here"
  modeline_file fzfrc '--cycle\n\n# vim:syn=bash:ft=\n'
  [ "$(render_engine "$BATS_TEST_TMPDIR/fzfrc")" = "bash syntax" ]
  # As nvcat-dispatch and bat-dynamic call it.
  [ "$(render_engine "$BATS_TEST_TMPDIR/fzfrc" --filetype bash)" = "bash syntax" ]
  # Another filetype than the modeline's keeps --syntax auto.
  modeline_file other '# vim: syn=bash\necho\n'
  [ "$(render_engine "$BATS_TEST_TMPDIR/other" --filetype markdown)" = "markdown render-markdown" ]
  modeline_file ft.txt '# vim: ft=bash\necho x\n'
  engine=$(render_engine "$BATS_TEST_TMPDIR/ft.txt")
  [[ $engine == "bash treesitter" || $engine == "bash syntax" ]]
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import filetypes
assert filetypes.regex_modeline(sys.argv[2], "bash") is False' "$ROOT" "$BATS_TEST_TMPDIR/ft.txt"
}
