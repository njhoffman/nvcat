#!/usr/bin/python3
"""Generate nvcat-dispatch, a fast bash router between nvcat and bat, from the filetype tables, and
filetypes.bat.json, bat's claims for nvcat itself."""

import argparse
import json
from pathlib import Path
import re
import shlex
import sys

import filetypes

ROOT = Path(__file__).resolve().parent


def bash_pattern(glob):
  """Quote a glob for a case label, keeping only * and ? special."""
  return "".join(character if character in "*?" else shlex.quote(character) if not character.isalnum()
                 and character not in "._-/" else character for character in glob)


def covers(glob, other):
  """True when glob matches every string the glob other matches. other's own * and ? are matched as characters,
  which only glob's * can match; a ? in glob could match a * in other wrongly, so such a glob covers nothing."""
  return "?" not in glob and re.fullmatch(".*".join(map(re.escape, glob.split("*"))), other, re.DOTALL) is not None


def reachable(globs):
  """globs without those another one covers: they share a case label, so they could never add a match."""
  kept = []
  for glob in globs:
    if not any(covers(other, glob) for other in kept):
      kept = [other for other in kept if not covers(glob, other)] + [glob]
  return kept


def requirement(entry):
  requires = entry.get("requires", {})
  checks = []
  if "ancestor_file" in requires:
    checks.append(f'[[ -f ${{1%/templates/*}}/{bash_pattern(requires["ancestor_file"])} ]]')
  if "head_regex" in requires:
    checks.append(f'head -n {filetypes.HEAD_LINES} -- "$1" 2>/dev/null | grep -qiE -- '
                  + shlex.quote(requires["head_regex"]))
  return " && ".join(checks)


BATCH = 3  # Runs of at least this many extension-only entries share one case statement over suffixes.


def runs(entries):
  """Split entries into runs: extension-only entries without requirements together, every other entry alone."""
  current = []
  for entry in entries:
    if set(entry) <= {"filetype", "extensions", "lang", "prefer_over_bat", "detect"} and entry.get("extensions"):
      current.append(entry)
      continue
    if current:
      yield current
      current = []
    yield [entry]
  if current:
    yield current


def body(entries):
  """detect() lines for entries in match order; each match sets REPLY and returns 0.

  Bash string operations on one large table are quadratic, and an associative array of ~900 keys takes longer
  to build than the matching it saves, so the tables are case statements: a run of extension-only entries is
  one case over the file name's suffixes (the lowest entry number among the matching suffixes wins, as the
  first matching case would), and consecutive plain entries share one case statement, tried in order."""
  out = []
  for run in runs(entries):
    if len(run) >= BATCH:
      out += [f"  # {run[0]['filetype']} .. {run[-1]['filetype']}",
              "  name=${1##*/} best=",
              "  while [[ $name == *.* ]]; do",
              "    name=${name#*.} value=",
              "    case $name in"]
      seen = set()
      for number, entry in enumerate(run):
        keys = [key.lower() for key in entry["extensions"] if key.lower() not in seen]
        seen.update(keys)
        if keys:
          out.append(f"      {' | '.join(bash_pattern(key) for key in keys)}) value='{number} {entry['filetype']}' ;;")
      out += ["    esac",
              "    if [[ -n $value ]] && { [[ -z $best ]] || (( ${value%% *} < ${best%% *} )); }; then best=$value; fi",
              "  done",
              "  [[ -n $best ]] && { REPLY=${best#* }; return 0; }"]
      continue
    for entry in run:
      labels = " | ".join(bash_pattern(glob) for glob in reachable(filetypes.globs(entry)))
      check = requirement(entry)
      if check:
        out.append(f"  case $1 in {labels}) {check} && {{ REPLY={entry['filetype']}; return 0; }} ;; esac")
      elif out and out[-1] == "  esac" and out[-2].endswith("return 0 ;;"):
        out.insert(-1, f"    {labels}) REPLY={entry['filetype']}; return 0 ;;")
      else:
        out += ["  case $1 in", f"    {labels}) REPLY={entry['filetype']}; return 0 ;;", "  esac"]
  return out


WHOLE_LINES = 512  # Files with fewer lines are read by mapfile; a longer one's last line costs a tail fork.


def modeline_functions():
  """Bash for the line half of filetypes.modeline_filetype(): the same patterns, the same first and last line.
  Checking the names against highlighted() happens in stage two (accepted_functions), so bash parses the list
  of filetypes only for files with a modeline."""
  limit = filetypes.MODELINE_BYTES
  return [
    "# A Vim modeline's ft=/filetype= (else syn=/syntax=) in line $1; returns 0 with REPLY set.",
    f"modeline_marker={shlex.quote(filetypes.MODELINE_MARKER)}",
    f"modeline_set={shlex.quote(filetypes.MODELINE_SET)}",
    "modeline() {",
    "  REPLY=",
    "  local line=${1%$'\\r'} rest word filetype='' syntax=''",
    "  local -a words",
    "  [[ $line =~ $modeline_marker ]] || return 1",
    "  rest=${BASH_REMATCH[4]}",
    "  if [[ $rest =~ $modeline_set ]]; then rest=${BASH_REMATCH[1]}; else rest=${rest//:/ }; fi",
    "  read -ra words <<<\"$rest\"",
    "  for word in \"${words[@]}\"; do",
    "    case $word in",
    "      ft=* | filetype=*) filetype=${word#*=} ;;",
    "      syn=* | syntax=*) syntax=${word#*=} ;;",
    "    esac",
    "  done",
    "  REPLY=${filetype:-$syntax}",
    f"  [[ $REPLY =~ {filetypes.FILETYPE_NAME} ]] || {{ REPLY=; return 1; }}",
    "}",
    "",
    "# The filetypes named by modelines in file $1's first and last lines, as named=(first last); returns 1",
    f"# without any. mapfile reads a file of under {WHOLE_LINES} lines (no fork); a longer one, or one whose first",
    f"# line is {limit} characters or more, gets its end from tail.",
    "modelines() {",
    "  local first last i",
    "  local -a lines",
    "  named=()",
    f"  {{ IFS= read -r -n {limit} first || [[ -n $first ]]; }} < \"$1\" 2>/dev/null || return 1",
    f"  if (( ${{#first}} < {limit} )) && {{ mapfile -t -n {WHOLE_LINES} lines < \"$1\"; }} 2>/dev/null &&",
    f"     (( ${{#lines[@]}} < {WHOLE_LINES} )); then",
    "    last=",
    "    for (( i = ${#lines[@]} - 1; i >= 0; i-- )); do",
    "      [[ -n ${lines[i]} ]] && { last=${lines[i]}; break; }",
    "    done",
    "  else",
    f"    {{ last=$(tail -c {limit} -- \"$1\"); }} 2>/dev/null",
    "    last=${last##*$'\\n'}",
    "  fi",
    f"  (( ${{#last}} > {limit} )) && last=${{last: -{limit}}}",
    "  modeline \"$first\" && named+=(\"$REPLY\")",
    "  modeline \"$last\" && named+=(\"$REPLY\")",
    "  (( ${#named[@]} ))",
    "}",
    "",
  ]


def accepted_functions(accepted):
  names = " | ".join(sorted(accepted))
  return [
    "# Filetypes nvcat's Neovim can highlight (filetypes.highlighted()), for the modelines found in stage one.",
    "accepted() {",
    f"  case $1 in {names}) return 0 ;; esac",
    "  return 1",
    "}",
    "",
    "if (( ${#named[@]} )); then",
    "  shopt -u nocasematch",
    "  for name in \"${named[@]}\"; do accepted \"$name\" && route \"$name\"; done",
    "  shopt -s nocasematch",
    "  detect \"$path\"",
    "  case $? in 0) route \"$REPLY\" ;; 1) route '' ;; esac",
    "fi",
    "",
  ]


# sed scripts for bat's two streams: its stdout keeps ESC for its own SGR, and error messages quote the file name.
UNSAFE_OUTPUT = r"s/\xc2[\x80-\x9f]|[\x00-\x08\x0b\x0c\x0e-\x1a\x1c-\x1f\x7f]//g"
UNSAFE_ERRORS = r"s/\xc2[\x80-\x9f]|\x1b\[[0-9;:]*m|[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]//g"


def generate(first, rest, version, patterns, strips=True):
  strip = ["  options+=(--strip-ansi=always)"] if strips else []
  """The dispatch script: entries in first are checked in stage one, rest (in order after them) in stage two."""
  entries = first + rest
  claimed = []
  for syntax, pattern in patterns:
    entry = filetypes.detect(filetypes.sample(pattern), entries)
    if entry and not entry.get("prefer_over_bat") and pattern not in [item[1] for item in claimed]:
      claimed.append((syntax, pattern))
  out = [
    "#!/usr/bin/env bash",
    "# shellcheck disable=SC2209  # REPLY=m4 is a filetype name, not a command whose output was meant.",
    f"# Generated by ./gen-dispatch from filetypes.json, filetypes.regex.json and bat {version}. Do not edit; regenerate instead.",
    "#",
    "# Usage: nvcat-dispatch [--] FILE          render FILE with nvcat, else with bat",
    "#        nvcat-dispatch --print [--] FILE  print the nvcat filetype; exit 1 when bat handles FILE",
    f"#                                          ('{filetypes.AUTO}': Neovim detects by content, nvcat "
    f"--filetype {filetypes.AUTO}",
    "#                                          hands filetypes it has no entry for to bat)",
    "#        -- ends the options, for a FILE named --print or starting with -",
    "#",
    "# A Vim modeline in FILE's first or last line that names one of nvcat's filetypes (ft= or filetype=,",
    "# else syn= or syntax=) wins over everything else; no other modeline option is applied.",
    "#",
    "# NVCAT and BAT override the commands. nvcat errors are discarded and the file goes to bat.",
    "#",
    "# Two stages: bash parses a script as it runs it, so the generated filetypes in stage two cost nothing for",
    "# a file that filetypes.json matches or that bat claims.",
    "",
    "# Stage one: returns 0 with REPLY set on a match, 1 when bat claims the file, 2 otherwise.",
    "detect() {",
    "  REPLY=",
    "  local name best value",
  ]
  if claimed:
    out.append("  case $1 in")
    for syntax, pattern in claimed:
      out.append(f"    {bash_pattern(pattern)}) return 1 ;;  # bat: {syntax}")
    out.append("  esac")
  out += body(first)
  out += [
    "  return 2",
    "}",
    "",
  ]
  out += modeline_functions()
  out += [
    "# Print or render with the filetype in $1, or with bat when it is empty; never returns.",
    "route() {",
    "  shopt -u nocasematch",
    "  if (( print )); then",
    "    [[ -n $1 ]] && printf '%s\\n' \"$1\" && exit 0",
    "    exit 1",
    "  fi",
    "  if [[ -n $1 ]] && command -v \"${NVCAT:-nvcat}\" >/dev/null 2>&1; then",
    "    \"${NVCAT:-nvcat}\" --all --paging=never --budget=2 --filetype \"$1\" -- \"$file\" 2>/dev/null && exit 0",
    "  fi",
    "  # The file's own escapes stay out of the terminal: bat's --strip-ansi needs decorations on to act without color",
    "  # (--style=plain shows none), and leaves BEL and C1 controls, which sed removes; ESC survives only in bat's SGR.",
    "  local color=${NVCAT_COLOR:-}",
    "  case $color in",
    "    never | always) ;;",
    "    auto) if [[ -t 1 || -n ${FZF_PREVIEW_COLUMNS:-}${FZF_PREVIEW_LINES:-}${NVIM:-} ]]; then color=always; else color=never; fi ;;",
    "    *) if [[ -n ${NO_COLOR:-} ]]; then color=never; else color=always; fi ;;",
    "  esac",
    "  local -a options=(\"--color=$color\")",
    "  [[ $color == never ]] && options+=(--decorations=always --style=plain)",
    *strip,
    "  \"${BAT:-bat}\" \"${options[@]}\" --paging=never -- \"$file\" \\",
    f"    2> >(LC_ALL=C sed -E '{UNSAFE_ERRORS}' >&2) | LC_ALL=C sed -E '{UNSAFE_OUTPUT}'",
    "  local status=${PIPESTATUS[0]}",
    "  wait $! 2>/dev/null",
    "  exit \"$status\"",
    "}",
    "",
    "print=0",
    "if [[ ${1-} == --print ]]; then print=1; shift; fi",
    "if [[ ${1-} == -- ]]; then shift; fi",
    "if [[ $# -ne 1 ]]; then",
    "  echo 'usage: nvcat-dispatch [--print] [--] FILE' >&2",
    "  exit 2",
    "fi",
    "file=$1",
    "path=$file",
    "[[ $path == /* ]] || path=$PWD/$path",
    "[[ -f $file ]] || route ''",
    "named=()",
    "if ! modelines \"$file\"; then",
    "  shopt -s nocasematch",
    "  detect \"$path\"",
    "  case $? in 0) route \"$REPLY\" ;; 1) route '' ;; esac",
    "fi",
    "",
    "# Stage two, parsed only when stage one found nothing or a modeline: nvcat's filetypes for the",
    "# modeline, then filetypes.regex.json and the 'last' entries.",
  ]
  out += accepted_functions(filetypes.highlighted())
  out += [
    "detect_more() {",
    "  REPLY=",
    "  local name best value",
  ]
  out += body(rest)
  out += [
    "  return 1",
    "}",
    "",
    "detect_more \"$path\" && route \"$REPLY\"",
    "route ''",
  ]
  return "\n".join(out) + "\n", claimed


def main():
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--output", type=Path, default=ROOT / "nvcat-dispatch", help="Script to write, or - for stdout")
  parser.add_argument("--claims", type=Path, default=filetypes.CLAIMS,
                      help="JSON file for bat's claims, or - to leave it alone")
  args = parser.parse_args()
  try:
    version, patterns = filetypes.bat_patterns()
  except FileNotFoundError:
    print("gen-dispatch: bat is not installed; generating without bat's claims (every other file still goes "
          "to bat, which fails until it is installed)", file=sys.stderr)
    version, patterns = "(not installed)", []
  entries = filetypes.ordered()
  first = [entry for entry in filetypes.load() if not entry.get("last")]
  strips = filetypes.bat_strips_ansi()
  if patterns and not strips:
    print("gen-dispatch: this bat has no --strip-ansi (bat 0.25.0 and later); a file's escape sequences reach the terminal "
          "through nvcat-dispatch's bat branch", file=sys.stderr)
  script, claimed = generate(first, entries[len(first):], version, patterns, strips)
  if str(args.output) == "-":
    sys.stdout.write(script)
  else:
    args.output.write_text(script)
    args.output.chmod(0o755)
    print(f"Wrote {args.output} ({len(claimed)} bat-claimed patterns)", file=sys.stderr)
  if str(args.claims) != "-":
    args.claims.write_text(claims_json(claimed, version))
  return 0


def claims_json(claimed, version):
  """filetypes.bat.json: the patterns nvcat-dispatch sends to bat ahead of the tables, one per line."""
  description = (f"Generated by ./gen-dispatch from bat {version}; do not edit. bat's file names and globs that a "
                 "filetypes.json or filetypes.regex.json entry would otherwise match, as [bat syntax, glob]. "
                 "nvcat lets Neovim detect these files instead of using the entry.")
  return ("{\n  \"description\": " + json.dumps(description) + ",\n  \"claims\": [\n"
          + ",\n".join("    " + json.dumps(list(item)) for item in claimed) + "\n  ]\n}\n")


if __name__ == "__main__":
  raise SystemExit(main())
