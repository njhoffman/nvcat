#!/usr/bin/python3
"""nvcat: Neovim-rendered cat, pager and fzf preview. The code is in nvcat_cli.py, imported so that Python
caches its bytecode instead of compiling it on every start."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))  # PYTHONSAFEPATH leaves the script's directory out.
if os.environ.get("NVCAT_WORKER") == "1":
  from nvcat_client import preview  # noqa: E402

  if (status := preview(sys.argv[1:])) is not None:
    sys.exit(status)
from nvcat_cli import command  # noqa: E402

command()
