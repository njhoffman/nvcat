#!/usr/bin/python3
"""Trial: what would a persistent Neovim worker save on fzf previews, and does it print the same bytes?

A worker process holds one embedded Neovim and serves previews over a Unix socket to a thin client; the times are
wall clock for the client process, against a fresh nvcat, in alternating pairs. Records nothing. Parts:
output (worker bytes against fresh nvcat, every sample and fixture, shuffled, two passes, two sizes), latency,
cancel (a request abandoned just before another), memory (Neovim's RSS over many previews).
"""

import argparse
import contextlib
import json
import os
import random
import socket
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from common import HERE, ROOT, SAMPLES

sys.path.insert(0, str(ROOT))
from nvcat_worker import MAX_RSS_MIB, rss_mib

COLUMNS, LINES = 100, 40
LATENCY_EXTRA = ["tests/fixtures/astro/page.astro", "tests/fixtures/cuda/kernel.cu", "README.md"]


def fresh_command(path, width, height):
  environment = {k: v for k, v in os.environ.items() if k not in ("NVIM",)}
  environment.update(FZF_PREVIEW_COLUMNS=str(width), FZF_PREVIEW_LINES=str(height))
  return [str(ROOT / "nvcat"), "--paging=never", "--timeout", "20", str(path)], environment


class Worker:
  """A worker of its own, reached as fzf reaches it: the nvcat command with NVCAT_WORKER=1."""

  def __init__(self, environment=None):
    self.environment = environment

  def __enter__(self):
    self.directory = tempfile.TemporaryDirectory(prefix="nvcat-worker-")
    os.chmod(self.directory.name, 0o700)
    self.socket = str(Path(self.directory.name) / "worker.socket")
    self.process = subprocess.Popen([sys.executable, str(ROOT / "nvcat_worker.py"), self.socket],
                                    env={**os.environ, **(self.environment or {})})
    deadline = time.monotonic() + 10
    while not Path(self.socket).exists():
      assert time.monotonic() < deadline, "the worker did not start"
      time.sleep(0.01)
    return self

  def __exit__(self, *_):
    with contextlib.suppress(OSError):
      self.ask({"quit": True})
    try:
      self.process.wait(timeout=5)
    except subprocess.TimeoutExpired:
      self.process.kill()
    self.directory.cleanup()

  def ask(self, request):
    with socket.socket(socket.AF_UNIX) as connection:
      connection.connect(self.socket)
      connection.sendall(json.dumps(request).encode() + b"\n")
      return connection.makefile().read()

  def command(self, path, width, height, environment):
    return ([str(ROOT / "nvcat"), str(path)],
            {**os.environ, **(environment or {}), "NVCAT_WORKER": "1", "NVCAT_WORKER_DIR": self.directory.name,
             "FZF_PREVIEW_COLUMNS": str(width), "FZF_PREVIEW_LINES": str(height)})

  def preview(self, path, width=COLUMNS, height=LINES, environment=None):
    command, variables = self.command(path, width, height, environment)
    return subprocess.run(command, env=variables, capture_output=True, check=False)

  def abandon(self, path, after_ms):
    """Start a preview and kill its client after a delay, as fzf does when the selection moves."""
    command, variables = self.command(path, COLUMNS, LINES, None)
    client = subprocess.Popen(command, env=variables, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(after_ms / 1000)
    client.terminate()
    client.wait()

  def stats(self):
    return json.loads(self.ask({"stats": True}))

  def rss_mib(self):
    return rss_mib(self.stats()["nvim"])


def timed(function):
  start = time.perf_counter()
  result = function()
  return (time.perf_counter() - start) * 1000, result


def documents():
  files = [HERE / f"{sample}.md" for sample in SAMPLES]
  for file in sorted((ROOT / "tests/fixtures").rglob("*")):
    if not file.is_file():
      continue
    with open(file, "rb") as handle:
      if b"\0" in handle.read(8192):
        continue
    files.append(file)
  return files


def output_part(seed, verbose, abandon=False):
  chooser = random.Random(seed + 1)
  sizes = [(COLUMNS, LINES), (80, 24)]
  files = documents()
  expected = {}
  for file in files:
    for width, height in sizes:
      command, environment = fresh_command(file, width, height)
      result = subprocess.run(command, env=environment, capture_output=True, check=False)
      expected[file, width, height] = (result.returncode, result.stdout, result.stderr)
  fell_back = {key for key, value in expected.items() if value[0] != 0 or b"showing bat" in value[2]}
  jobs = [(file, *size) for file in files for size in sizes if (file, *size) not in fell_back] * 2
  random.Random(seed).shuffle(jobs)
  different = {}
  failed = {}
  with Worker() as worker:
    for file, width, height in jobs:
      if abandon:
        worker.abandon(chooser.choice(files), chooser.choice((0, 25, 50, 100, 150)))
      result = worker.preview(file, width, height)
      if result.returncode:
        failed[file, width, height] = result.stderr.decode(errors="replace").strip()
      elif result.stdout != expected[file, width, height][1]:
        different[file, width, height] = different.get((file, width, height), 0) + 1
    print(f"worker stats: {({k: v for k, v in worker.stats().items() if k not in ('stat_ms', 'nvim')})}")
  print(f"output{' with an abandoned preview before each' if abandon else ''}: {len(jobs)} previews of {len(files)} files, seed {seed}; {len(fell_back)} size/file pairs left out (fresh nvcat "
        f"fell back or failed); different {len(different)} pairs, failed {len(failed)} pairs")
  if verbose:
    for key, count in sorted(different.items(), key=str):
      print(f"  different {count}x: {key[0].relative_to(ROOT)} {key[1]}x{key[2]}")
    for key, message in sorted(failed.items(), key=str):
      print(f"  failed: {key[0].relative_to(ROOT)} {key[1]}x{key[2]}: {message[:150]}")
  return not different and not failed


def latency_part(rounds):
  files = [HERE / f"{sample}.md" for sample in SAMPLES] + [ROOT / name for name in LATENCY_EXTRA]
  print("| Document | Fresh nvcat (ms) | Worker, first of this filetype (ms) | Worker, repeat (ms) | Worker, change of document (ms) | Saved, repeat |")
  print("|---|---:|---:|---:|---:|---:|")
  for file in files:
    command, environment = fresh_command(file, COLUMNS, LINES)
    fresh, repeat, switch, first = [], [], [], []
    other = HERE / "small.md" if file.name != "small.md" else HERE / "medium.md"
    for _ in range(3):
      with Worker() as worker:
        first.append(timed(lambda worker=worker: worker.preview(file))[0])
    with Worker() as worker:
      worker.preview(file)
      worker.preview(other)
      for number in range(rounds):
        order = [0, 1] if number % 2 else [1, 0]
        for which in order:
          if which:
            fresh.append(timed(lambda: subprocess.run(command, env=environment, capture_output=True, check=True))[0])
          else:
            repeat.append(timed(lambda: worker.preview(file))[0])
        worker.preview(other)
        switch.append(timed(lambda: worker.preview(file))[0])
      served = worker.stats()["previews"]
    assert served >= rounds * 3, f"only {served} previews came from the worker"
    a, b = statistics.median(fresh), statistics.median(repeat)
    print(f"| {file.name} | {a:.0f} | {statistics.median(first):.0f} | {b:.0f} | {statistics.median(switch):.0f} | {100 * (a - b) / a:.0f}% |", flush=True)


def cancel_part(rounds):
  small = HERE / "small.md"
  big = HERE / "large.md"
  print("| Client killed after (ms) | Next preview of small.md (ms) | Normal (ms) | Added (ms) |")
  print("|---|---:|---:|---:|")
  with Worker() as worker:
    worker.preview(big)
    worker.preview(small)
    for after in (0, 25, 50, 75, 100, 150):
      normal, cancelled = [], []
      for _ in range(rounds):
        normal.append(timed(lambda: worker.preview(small))[0])
        for _ in range(3):  # Moving through a list: each preview abandoned in turn.
          worker.abandon(big, after)
        cancelled.append(timed(lambda: worker.preview(small))[0])
      a, b = statistics.median(normal), statistics.median(cancelled)
      print(f"| {after} | {b:.0f} | {a:.0f} | {b - a:+.0f} |", flush=True)


def stale_part():
  """Worker output after each thing a user changes must equal a fresh nvcat's under the same change."""
  work = Path(tempfile.mkdtemp(prefix="nvcat-stale-"))
  theme = work / "theme.lua"
  conf = work / "config.toml"
  def write_theme(color):
    theme.write_text('return { apply = function() vim.api.nvim_set_hl(0, "Normal", { fg = "%s" })\n'
                     'vim.api.nvim_set_hl(0, "markdownH1", { fg = "%s" })\n'
                     'vim.api.nvim_set_hl(0, "@markup.heading.1.markdown", { fg = "%s" }) end }\n' % (color, color, color))
  write_theme("#112233")
  conf.write_text(f'theme = "{theme}"\n')
  environment = {"NVCAT_CONFIG": str(conf)}
  document = HERE / "small.md"
  def check(name, worker, variables, expect_restart):
    before = worker.stats()["stale"]
    result = worker.preview(document, environment=variables)
    command, env = fresh_command(document, COLUMNS, LINES)
    fresh = subprocess.run(command, env={**env, **variables}, capture_output=True, check=True)
    restarted = worker.stats()["stale"] - before
    good = result.returncode == 0 and result.stdout == fresh.stdout and restarted == expect_restart
    print(f"stale: {name}: {'same as fresh' if result.stdout == fresh.stdout else 'DIFFERENT'}, restarts {restarted}, "
          f"expected {expect_restart}{'' if good else '  FAILED ' + result.stderr.decode()[:200]}", flush=True)
    return good
  ok = True
  with Worker(environment) as worker:
    ok &= check("first preview", worker, environment, 0)
    ok &= check("nothing changed", worker, environment, 0)
    write_theme("#aa5500")
    ok &= check("theme file edited", worker, environment, 1)
    conf.write_text(f'theme = "{theme}"\ncolor = "never"\n')
    ok &= check("config.toml edited", worker, environment, 1)
    conf.write_text(f'theme = "{theme}"\n')
    ok &= check("config.toml edited back", worker, environment, 1)
    ok &= check("NVCAT_COLOR set in the client", worker, {**environment, "NVCAT_COLOR": "never"}, 1)
    ok &= check("NVCAT_COLOR gone again", worker, environment, 1)
    good = worker.preview(document, environment=environment)
    conf.write_text('nonsense = [\n')
    bad = worker.preview(document, environment=environment)
    print(f"stale: broken config: client exit {bad.returncode}, says {bad.stderr.decode()[:90].strip()!r}", flush=True)
    ok &= bad.returncode == 1 and good.returncode == 0
    conf.write_text(f'theme = "{theme}"\n')
    ok &= check("config repaired", worker, environment, 0)  # The broken config already stopped the old Neovim.
    print("stale: stat check " + str(round(statistics.median(worker.stats()["stat_ms"]), 2)) + " ms per preview", flush=True)
  return ok


def memory_part(count):
  files = documents()
  with Worker() as worker:
    start = worker.rss_mib()
    marks = []
    for number in range(count):
      worker.preview(files[number % len(files)])
      if (number + 1) % (count // 4) == 0:
        marks.append(f"{number + 1}: {worker.rss_mib():.0f}")
    print(f"memory: Neovim RSS {start:.0f} MiB at start; after previews " + ", ".join(marks) + f" MiB; "
          f"restarts over {MAX_RSS_MIB} MiB: {worker.stats()['over_rss']}")


if __name__ == "__main__":
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--part", choices=["output", "output-cancel", "stale", "latency", "cancel", "memory"], action="append")
  parser.add_argument("--rounds", type=int, default=9)
  parser.add_argument("--seed", type=int, default=1)
  parser.add_argument("--verbose", action="store_true")
  args = parser.parse_args()
  parts = args.part or ["output", "output-cancel", "stale", "latency", "cancel", "memory"]
  ok = True
  if "output" in parts:
    ok = output_part(args.seed, args.verbose)
  if "output-cancel" in parts:
    ok = output_part(args.seed, args.verbose, abandon=True) and ok
  if "stale" in parts:
    ok = stale_part() and ok
  if "latency" in parts:
    latency_part(args.rounds)
  if "cancel" in parts:
    cancel_part(args.rounds)
  if "memory" in parts:
    memory_part(300)
  sys.exit(0 if ok else 1)
