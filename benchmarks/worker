#!/usr/bin/python3
"""Trial: what would a persistent Neovim worker save on fzf previews, and does it print the same bytes?

A worker process holds one embedded Neovim and serves previews over a Unix socket to a thin client; the times are
wall clock for the client process, against a fresh nvcat, in alternating pairs. Records nothing. Parts:
output (worker bytes against fresh nvcat, every sample and fixture, shuffled, two passes, two sizes), latency,
cancel (a request abandoned just before another), memory (Neovim's RSS over many previews).
"""

import argparse
import contextlib
import json
import os
from pathlib import Path
import random
import shutil
import signal
import socket
import statistics
import subprocess
import sys
import tempfile
import time

from common import HERE, ROOT, SAMPLES

sys.path.insert(0, str(ROOT))
import config  # noqa: E402
import filetypes  # noqa: E402
import nvcat_cli as nvcat  # noqa: E402

CLIENT = HERE / "worker_client.py"
COLUMNS, LINES = 100, 40
MAX_RSS_MIB = 200  # A worker's Neovim grows with what it has cached, and restarting it costs one slower preview.
GRACE_SECONDS = 0.3  # A cancelled render that Neovim cannot leave by then is cheaper to kill than to wait out.
LATENCY_EXTRA = ["tests/fixtures/astro/page.astro", "tests/fixtures/cuda/kernel.cu", "README.md"]


def client_variable(name):
  """The variables worker_client.py sends: what decides the config and color. The worker runs under the client's."""
  return (name.startswith("NVCAT_") and name != "NVCAT_TEST_SESSION") or name in ("NO_COLOR", "XDG_CONFIG_HOME", "HOME")


def fresh_command(path, width, height):
  environment = {k: v for k, v in os.environ.items() if k not in ("NVIM",)}
  environment.update(FZF_PREVIEW_COLUMNS=str(width), FZF_PREVIEW_LINES=str(height))
  return [str(ROOT / "nvcat"), "--paging=never", "--timeout", "20", str(path)], environment


def settle(renderer):
  """After a cancelled render: True when Neovim answers within the grace period, else kill it and return False.
  Lua that is running cannot be interrupted over RPC, and a large file can hold Neovim for seconds."""
  renderer.watch = None
  timeout, renderer.timeout = renderer.timeout, GRACE_SECONDS
  try:
    # Wiping can be the slow part, and work queued for the document follows it, so answer only after both.
    renderer.request("nvim_exec_lua", "nvcat.reset()", [])
    renderer.request("nvim_exec_lua", "return 0", [])
    return True
  except nvcat.TimedOut:
    os.killpg(renderer.process.pid, signal.SIGKILL)
    renderer.process.wait()
    renderer.close()
    return False
  finally:
    renderer.timeout = timeout


def tracked(settings, paths):
  """The files a running Neovim has already read: when one changes it is stale, and its colors would be silently old."""
  files = [config.config_file(), ROOT / "profile.lua", ROOT / "nvcat_cli.py", ROOT / "config.py",
           Path(shutil.which(settings["nvim"]) or settings["nvim"])]
  for value in (paths.get("theme"), paths.get("markdown_options")):
    if value:
      files += sorted(Path(value).parent.rglob("*.lua"))  # A theme or an options file can require its neighbours.
  for value in (paths.get("parser_dir"), paths.get("render_markdown"), paths.get("icons")):
    if value:
      files += [Path(value), *sorted(Path(value).glob("*"))]
      files += sorted((Path(value) / "parser").glob("*"))
  return files


def fingerprint(files):
  stamps = []
  for file in files:
    try:
      status = file.stat()
      stamps.append((status.st_mtime_ns, status.st_size))
    except OSError:
      stamps.append(None)
  return stamps


def serve(socket_path):
  stats = {"previews": 0, "skipped": 0, "cancelled": 0, "killed": 0, "stale": 0, "over_rss": 0, "stat_ms": []}
  listener = socket.socket(socket.AF_UNIX)
  listener.bind(socket_path)
  listener.listen(16)
  with nvcat.run_directory() as temporary:
    nvcat.restrict_writes(temporary)
    state = {}

    def start(environment):
      """Read the config as the client's environment gives it, and start a Neovim with it."""
      for name in [name for name in os.environ if client_variable(name)]:
        del os.environ[name]
      os.environ.update(environment)
      settings = config.load()[0]
      color = nvcat.use_color(settings["color"])
      links = color and nvcat.hyperlinks(settings["hyperlinks"], nvcat.resolve_pager(settings["pager"]), "never", False)
      if links:
        links = settings["link_schemes"] or config.DEFAULT_LINK_SCHEMES
      paths = nvcat.find_paths(settings)
      state.update(environment=environment, files=tracked(settings, paths))
      state.update(stamps=fingerprint(state["files"]), width=COLUMNS, height=LINES)
      state["renderer"] = nvcat.Renderer(settings["nvim"], paths, temporary, COLUMNS, LINES, 20, nvcat.Timings(), "auto",
                                         links, color)

    start({k: v for k, v in os.environ.items() if client_variable(k)})
    print(f"ready {state['renderer'].process.pid}", flush=True)
    while True:
      connection, _ = listener.accept()
      with connection:
        request = json.loads(connection.makefile().readline())
        if request.get("quit"):
          break
        if request.get("stats"):
          connection.sendall(json.dumps({**stats, "nvim": state["renderer"].process.pid}).encode())
          continue
        if nvcat.client_gone(connection):  # Abandoned while it waited its turn.
          stats["skipped"] += 1
          continue
        try:
          environment = {k: v for k, v in request["environment"].items() if client_variable(k)}
          began = time.perf_counter()
          stale = fingerprint(state["files"]) != state["stamps"]
          stats["stat_ms"].append((time.perf_counter() - began) * 1000)
          if stale or environment != state["environment"]:
            stats["stale"] += 1
            state["renderer"].close()
            start(environment)
          renderer = state["renderer"]
          path = nvcat.input_path(Path(request["path"]))
          filetype = nvcat.resolve_filetype(None, Path(request["path"]))
          auto = filetype is not None and "accept" in filetype
          renderer.syntax = ("regex" if filetype and not auto and filetypes.regex_modeline(Path(request["path"]), filetype["filetype"])
                             else "auto")
          renderer.timings = nvcat.Timings()
          renderer.ready.clear()
          renderer.errors.clear()
          renderer.request("nvim_exec_lua", "nvcat.reset()", [])
          if (request["width"], request["height"]) != (state["width"], state["height"]):
            state["width"], state["height"] = request["width"], request["height"]
            renderer.request("nvim_ui_try_resize", state["width"], max(state["height"], nvcat.MIN_GRID_ROWS))
          renderer.watch = connection
          output, _ = renderer.render(path, state["width"], state["height"], 1, False, filetype)
          connection.sendall(b"O" + output)
          stats["previews"] += 1
        except BrokenPipeError:
          pass
        except nvcat.Cancelled:
          stats["cancelled"] += 1
          if not settle(state["renderer"]):
            stats["killed"] += 1
            start(state["environment"])
        except Exception as error:  # noqa: BLE001 - a trial reports every failure to its client, which can run fresh.
          with contextlib.suppress(OSError):
            connection.sendall(b"E" + f"{type(error).__name__}: {error}\n".encode())
        finally:
          state["renderer"].watch = None
      if rss_mib(state["renderer"].process.pid) > MAX_RSS_MIB:  # Between previews, so nobody waits on the close.
        stats["over_rss"] += 1
        state["renderer"].close()
        start(state["environment"])
    state["renderer"].close()


def rss_mib(pid):
  with contextlib.suppress(OSError):
    for line in Path(f"/proc/{pid}/status").read_text().splitlines():
      if line.startswith("VmRSS:"):
        return int(line.split()[1]) / 1024
  return 0.0


class Worker:
  def __init__(self, environment=None):
    self.environment = environment

  def __enter__(self):
    self.directory = tempfile.TemporaryDirectory(prefix="nvcat-worker-")
    self.socket = str(Path(self.directory.name) / "socket")
    self.process = subprocess.Popen([sys.executable, __file__, "--serve", self.socket], stdout=subprocess.PIPE, text=True,
                                    env={**os.environ, **(self.environment or {})})
    word, pid = self.process.stdout.readline().split()
    assert word == "ready", word
    self.nvim = int(pid)
    return self

  def __exit__(self, *_):
    with contextlib.suppress(OSError):
      with socket.socket(socket.AF_UNIX) as connection:
        connection.connect(self.socket)
        connection.sendall(b'{"quit": true}\n')
    try:
      self.process.wait(timeout=5)
    except subprocess.TimeoutExpired:
      self.process.kill()
    self.directory.cleanup()

  def preview(self, path, width=COLUMNS, height=LINES, environment=None):
    return subprocess.run([sys.executable, "-I", "-S", str(CLIENT), self.socket, str(path), str(width), str(height)],
                          capture_output=True, check=False, env={**os.environ, **(environment or {})})

  def abandon(self, path, after_ms):
    """Start a preview and kill its client after a delay, as fzf does when the selection moves."""
    client = subprocess.Popen([sys.executable, "-I", "-S", str(CLIENT), self.socket, str(path), str(COLUMNS), str(LINES)],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(after_ms / 1000)
    client.terminate()
    client.wait()

  def stats(self):
    with socket.socket(socket.AF_UNIX) as connection:
      connection.connect(self.socket)
      connection.sendall(b'{"stats": true}\n')
      return json.loads(connection.makefile().read())

  def rss_mib(self):
    return rss_mib(self.stats()["nvim"])


def timed(function):
  start = time.perf_counter()
  result = function()
  return (time.perf_counter() - start) * 1000, result


def documents():
  files = [HERE / f"{sample}.md" for sample in SAMPLES]
  for file in sorted((ROOT / "tests/fixtures").rglob("*")):
    if not file.is_file():
      continue
    with open(file, "rb") as handle:
      if b"\0" in handle.read(8192):
        continue
    files.append(file)
  return files


def output_part(seed, verbose, abandon=False):
  chooser = random.Random(seed + 1)
  sizes = [(COLUMNS, LINES), (80, 24)]
  files = documents()
  expected = {}
  for file in files:
    for width, height in sizes:
      command, environment = fresh_command(file, width, height)
      result = subprocess.run(command, env=environment, capture_output=True, check=False)
      expected[file, width, height] = (result.returncode, result.stdout, result.stderr)
  fell_back = {key for key, value in expected.items() if value[0] != 0 or b"showing bat" in value[2]}
  jobs = [(file, *size) for file in files for size in sizes if (file, *size) not in fell_back] * 2
  random.Random(seed).shuffle(jobs)
  different = {}
  failed = {}
  with Worker() as worker:
    for file, width, height in jobs:
      if abandon:
        worker.abandon(chooser.choice(files), chooser.choice((0, 25, 50, 100, 150)))
      result = worker.preview(file, width, height)
      if result.returncode:
        failed[file, width, height] = result.stderr.decode(errors="replace").strip()
      elif result.stdout != expected[file, width, height][1]:
        different[file, width, height] = different.get((file, width, height), 0) + 1
  print(f"output{' with an abandoned preview before each' if abandon else ''}: {len(jobs)} previews of {len(files)} files, seed {seed}; {len(fell_back)} size/file pairs left out (fresh nvcat "
        f"fell back or failed); different {len(different)} pairs, failed {len(failed)} pairs")
  if verbose:
    for key, count in sorted(different.items(), key=str):
      print(f"  different {count}x: {key[0].relative_to(ROOT)} {key[1]}x{key[2]}")
    for key, message in sorted(failed.items(), key=str):
      print(f"  failed: {key[0].relative_to(ROOT)} {key[1]}x{key[2]}: {message[:150]}")
  return not different and not failed


def latency_part(rounds):
  files = [HERE / f"{sample}.md" for sample in SAMPLES] + [ROOT / name for name in LATENCY_EXTRA]
  print("| Document | Fresh nvcat (ms) | Worker, first of this filetype (ms) | Worker, repeat (ms) | Worker, change of document (ms) | Saved, repeat |")
  print("|---|---:|---:|---:|---:|---:|")
  for file in files:
    command, environment = fresh_command(file, COLUMNS, LINES)
    fresh, repeat, switch, first = [], [], [], []
    other = HERE / "small.md" if file.name != "small.md" else HERE / "medium.md"
    for _ in range(3):
      with Worker() as worker:
        first.append(timed(lambda worker=worker: worker.preview(file))[0])
    with Worker() as worker:
      worker.preview(file)
      worker.preview(other)
      for number in range(rounds):
        order = [0, 1] if number % 2 else [1, 0]
        for which in order:
          if which:
            fresh.append(timed(lambda: subprocess.run(command, env=environment, capture_output=True, check=True))[0])
          else:
            repeat.append(timed(lambda: worker.preview(file))[0])
        worker.preview(other)
        switch.append(timed(lambda: worker.preview(file))[0])
    a, b = statistics.median(fresh), statistics.median(repeat)
    print(f"| {file.name} | {a:.0f} | {statistics.median(first):.0f} | {b:.0f} | {statistics.median(switch):.0f} | {100 * (a - b) / a:.0f}% |", flush=True)


def cancel_part(rounds):
  small = HERE / "small.md"
  big = HERE / "large.md"
  print("| Client killed after (ms) | Next preview of small.md (ms) | Normal (ms) | Added (ms) |")
  print("|---|---:|---:|---:|")
  with Worker() as worker:
    worker.preview(big)
    worker.preview(small)
    for after in (0, 25, 50, 75, 100, 150):
      normal, cancelled = [], []
      for _ in range(rounds):
        normal.append(timed(lambda: worker.preview(small))[0])
        for _ in range(3):  # Moving through a list: each preview abandoned in turn.
          worker.abandon(big, after)
        cancelled.append(timed(lambda: worker.preview(small))[0])
      a, b = statistics.median(normal), statistics.median(cancelled)
      print(f"| {after} | {b:.0f} | {a:.0f} | {b - a:+.0f} |", flush=True)


def stale_part():
  """Worker output after each thing a user changes must equal a fresh nvcat's under the same change."""
  work = Path(tempfile.mkdtemp(prefix="nvcat-stale-"))
  theme = work / "theme.lua"
  conf = work / "config.toml"
  def write_theme(color):
    theme.write_text('return { apply = function() vim.api.nvim_set_hl(0, "Normal", { fg = "%s" })\n'
                     'vim.api.nvim_set_hl(0, "markdownH1", { fg = "%s" })\n'
                     'vim.api.nvim_set_hl(0, "@markup.heading.1.markdown", { fg = "%s" }) end }\n' % (color, color, color))
  write_theme("#112233")
  conf.write_text(f'theme = "{theme}"\n')
  environment = {"NVCAT_CONFIG": str(conf)}
  document = HERE / "small.md"
  def check(name, worker, variables, expect_restart):
    before = worker.stats()["stale"]
    result = worker.preview(document, environment=variables)
    command, env = fresh_command(document, COLUMNS, LINES)
    fresh = subprocess.run(command, env={**env, **variables}, capture_output=True, check=True)
    restarted = worker.stats()["stale"] - before
    good = result.returncode == 0 and result.stdout == fresh.stdout and restarted == expect_restart
    print(f"stale: {name}: {'same as fresh' if result.stdout == fresh.stdout else 'DIFFERENT'}, restarts {restarted}, "
          f"expected {expect_restart}{'' if good else '  FAILED ' + result.stderr.decode()[:200]}", flush=True)
    return good
  ok = True
  with Worker(environment) as worker:
    ok &= check("first preview", worker, environment, 0)
    ok &= check("nothing changed", worker, environment, 0)
    write_theme("#aa5500")
    ok &= check("theme file edited", worker, environment, 1)
    conf.write_text(f'theme = "{theme}"\ncolor = "never"\n')
    ok &= check("config.toml edited", worker, environment, 1)
    conf.write_text(f'theme = "{theme}"\n')
    ok &= check("config.toml edited back", worker, environment, 1)
    ok &= check("NVCAT_COLOR set in the client", worker, {**environment, "NVCAT_COLOR": "never"}, 1)
    ok &= check("NVCAT_COLOR gone again", worker, environment, 1)
    good = worker.preview(document, environment=environment)
    conf.write_text('nonsense = [\n')
    bad = worker.preview(document, environment=environment)
    print(f"stale: broken config: client exit {bad.returncode}, says {bad.stderr.decode()[:90].strip()!r}", flush=True)
    ok &= bad.returncode == 1 and good.returncode == 0
    conf.write_text(f'theme = "{theme}"\n')
    ok &= check("config repaired", worker, environment, 1)
    print("stale: stat check " + str(round(statistics.median(worker.stats()["stat_ms"]), 2)) + " ms per preview", flush=True)
  return ok


def memory_part(count):
  files = documents()
  with Worker() as worker:
    start = worker.rss_mib()
    marks = []
    for number in range(count):
      worker.preview(files[number % len(files)])
      if (number + 1) % (count // 4) == 0:
        marks.append(f"{number + 1}: {worker.rss_mib():.0f}")
    print(f"memory: Neovim RSS {start:.0f} MiB at start; after previews " + ", ".join(marks) + f" MiB; "
          f"restarts over {MAX_RSS_MIB} MiB: {worker.stats()['over_rss']}")


if __name__ == "__main__":
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--serve")
  parser.add_argument("--part", choices=["output", "output-cancel", "stale", "latency", "cancel", "memory"], action="append")
  parser.add_argument("--rounds", type=int, default=9)
  parser.add_argument("--seed", type=int, default=1)
  parser.add_argument("--verbose", action="store_true")
  args = parser.parse_args()
  if args.serve:
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    serve(args.serve)
    sys.exit(0)
  parts = args.part or ["output", "output-cancel", "stale", "latency", "cancel", "memory"]
  ok = True
  if "output" in parts:
    ok = output_part(args.seed, args.verbose)
  if "output-cancel" in parts:
    ok = output_part(args.seed, args.verbose, abandon=True) and ok
  if "stale" in parts:
    ok = stale_part() and ok
  if "latency" in parts:
    latency_part(args.rounds)
  if "cancel" in parts:
    cancel_part(args.rounds)
  if "memory" in parts:
    memory_part(300)
  sys.exit(0 if ok else 1)
