#!/usr/bin/python3
"""Benchmark Markdown rendering, append the results to history.tsv, and update the table in SYNTAX.md.

Waits until the 1-minute load average is low enough, then renders each sample several times in three modes
(complete output, a 40-row viewport, and fzf's preview environment) and records the median wall time, the
median startup time (until Neovim is set up, from nvcat --timings-json) and the median peak RSS of Neovim
and of nvcat itself. The SYNTAX.md table compares the new wall-time medians with the average of all
earlier runs, and with the median of the last few: the average spans every version, so it hides a recent change.

The samples and modes run round-robin, one render of each per round, so a burst of load from another
process spreads over every row instead of ruining one. A run is noisy, and is printed but not recorded
(exit 3), when the load ends above --max-load or the typical startup is over 1.5 times its recent history:
startup does not depend on the document, so it shows load rather than a change. --record-noisy records it
anyway, for a startup that really changed. Exit 2 means the load never dropped low enough to start; exit 1 is
a failed render.
"""

import argparse
import json
import os
import statistics
import subprocess
import sys
import time

from common import (COLUMNS, HERE, LINES, MODES, ROOT, SAMPLES, WORKER_MODES, Worker, load1, metadata, render_command,
                    wait_for_load)
HISTORY = HERE / "history.tsv"
SYNTAX = ROOT / "SYNTAX.md"
# Phases up to a ready Neovim (nvcat --timings-json). Python's own interpreter start precedes them.
STARTUP_PHASES = ["python imports", "config", "input and filetype", "startup"]
FIELDS = ["date", "version", "commit", "sample", "mode", "median_ms", "min_ms", "runs", "load1", "nvim",
          "startup_ms", "nvim_rss_mib", "python_rss_mib"]
START, END = "<!-- benchmark:start -->", "<!-- benchmark:end -->"


NOISE_RATIO = 1.5  # Startup over this many times its recent median marks the run noisy.
RECENT_RUNS = 5  # Recorded runs per sample and mode that form that median and the table's recent one.


def render(sample, mode, timeout):
  """One render: (wall ms, startup ms, Neovim peak RSS MiB, nvcat peak RSS MiB)."""
  command, environment = render_command(ROOT, sample, mode, timeout, ["--timings-json"])
  start = time.perf_counter()
  result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment)
  elapsed = (time.perf_counter() - start) * 1000
  stderr = result.stderr.decode(errors="replace").strip()
  try:
    report = json.loads(stderr)  # Anything else on stderr (a warning, a fallback notice) fails the run.
  except ValueError:
    report = None
  if result.returncode != 0 or not result.stdout or report is None:
    raise SystemExit(f"benchmark: {sample}/{mode} failed: {stderr}")
  return (elapsed, sum(report["phases"].get(name, 0) for name in STARTUP_PHASES),
          report["peak_rss_kb"]["children"] / 1024, report["peak_rss_kb"]["python"] / 1024)


def worker_render(worker, sample, mode):
  """One preview from the worker, in render's terms. A served preview starts nothing, and its client is not measured."""
  start = time.perf_counter()
  result = worker.preview(HERE / f"{sample}.md", flags=WORKER_MODES[mode])
  elapsed = (time.perf_counter() - start) * 1000
  if result.returncode != 0 or not result.stdout or result.stderr:
    raise SystemExit(f"benchmark: {sample}/{mode} failed: {result.stderr.decode(errors='replace').strip()}")
  return elapsed, 0.0, worker.rss_mib(), 0.0


def all_served(stats, expected):
  """A preview that nvcat rendered by itself would be timed as a worker's."""
  if stats["previews"] != expected:
    raise SystemExit(f"benchmark: the worker served {stats['previews']} of {expected} previews: {stats}")


def measure(pairs, runs, timeout, render=render):
  """Per (sample, mode): median and minimum wall ms, median startup ms, and median peak RSS (MiB) of Neovim
  and of nvcat. One warm-up render of each pair (discarded: page cache, parsers), then runs rounds that
  render every pair once, so load bursts spread across the pairs."""
  for pair in pairs:
    render(*pair, timeout)
  results = {pair: [] for pair in pairs}
  for _ in range(runs):
    for pair in pairs:
      results[pair].append(render(*pair, timeout))
  summary = {}
  for pair, items in results.items():
    times, startups, nvim_rss, python_rss = zip(*items)
    summary[pair] = {"median_ms": round(statistics.median(times)), "min_ms": round(min(times)),
                     "startup_ms": round(statistics.median(startups)),
                     "nvim_rss_mib": round(statistics.median(nvim_rss)),
                     "python_rss_mib": round(statistics.median(python_rss))}
  return summary


def noise(rows, previous, load_end, max_load):
  """Why the run should not be recorded, or None. rows: this run; previous: history.tsv rows."""
  if load_end > max_load:
    return f"the load rose to {load_end:.2f} (over {max_load:.2f}) during the run"
  ratios = []
  for row in rows:
    earlier = [float(item["startup_ms"]) for item in previous
               if item["sample"] == row["sample"] and item["mode"] == row["mode"]
               and item.get("startup_ms") not in (None, "", "startup_ms")][-RECENT_RUNS:]
    if earlier and statistics.median(earlier) > 0:
      ratios.append(row["startup_ms"] / statistics.median(earlier))
  if ratios and statistics.median(ratios) > NOISE_RATIO:
    return (f"startup is {statistics.median(ratios):.1f}x its recent median (over {NOISE_RATIO}x), "
            "which points to load from another process")
  return None


def read_history():
  if not HISTORY.exists():
    return []
  lines = HISTORY.read_text().splitlines()
  return [dict(zip(FIELDS, line.split("\t"))) for line in lines[1:] if line]


def append_history(rows):
  header = "\t".join(FIELDS)
  if HISTORY.exists():
    lines = HISTORY.read_text().splitlines()
    if lines and lines[0] != header:  # New columns are appended; earlier rows simply lack them.
      HISTORY.write_text("\n".join([header, *lines[1:]]) + "\n")
  else:
    HISTORY.write_text(header + "\n")
  with open(HISTORY, "a", encoding="utf-8") as handle:
    for row in rows:
      handle.write("\t".join(str(row[field]) for field in FIELDS) + "\n")


def sample_stats(sample):
  text = (HERE / f"{sample}.md").read_text()
  return len(text.splitlines()), sum(1 for line in text.splitlines() if line.startswith("```") and line != "```")


def table(rows, previous):
  first = rows[0]
  out = [
    START,
    "",
    f"Latest run: {first['date']}, version {first['version']} ({first['commit']}), load {first['load1']}, "
    f"{first['nvim']}. Median of {first['runs']} runs after one warm-up, {COLUMNS} columns; complete output "
    f"uses `--all --budget 0`, viewport `--lines {LINES}`, fzf sets `FZF_PREVIEW_COLUMNS={COLUMNS}` and "
    f"`FZF_PREVIEW_LINES={LINES}` (the time to the first usable fzf preview). `worker` and `worker-all` are previews from "
    "`NVCAT_WORKER=1`, viewport and with `nvcat-dispatch`'s flags, each following a different document; their Startup and "
    "Python RSS are 0 and Neovim RSS is its current size. Startup is the time until Neovim "
    "is set up (`--timings`), excluding Python's interpreter start; RSS is the peak of Neovim and of "
    "nvcat's Python. Averages compare wall time with all earlier runs in "
    f"[benchmarks/history.tsv](benchmarks/history.tsv), Recent with the median of the last {RECENT_RUNS}; "
    "regenerate with `benchmarks/run`.",
    "",
    "| Sample | Lines | Code blocks | Mode | Latest (ms) | Average (ms) | Runs averaged | vs average | "
    "Recent (ms) | vs recent | Startup (ms) | Neovim RSS (MiB) | Python RSS (MiB) |",
    "|---|---:|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
  ]
  for row in rows:
    lines, blocks = sample_stats(row["sample"])
    earlier = [float(item["median_ms"]) for item in previous
               if item["sample"] == row["sample"] and item["mode"] == row["mode"]]
    if earlier:
      average = statistics.fmean(earlier)
      change = f"{(row['median_ms'] - average) / average * 100:+.0f}%"
      average_text = f"{average:.0f}"
      recent = statistics.median(earlier[-RECENT_RUNS:])
      recent_change = f"{(row['median_ms'] - recent) / recent * 100:+.0f}%"
      recent_text = f"{recent:.0f}"
    else:
      change, average_text, recent_change, recent_text = "first run", "-", "first run", "-"
    out.append(f"| [{row['sample']}](benchmarks/{row['sample']}.md) | {lines} | {blocks} | {row['mode']} | "
               f"{row['median_ms']:.0f} | {average_text} | {len(earlier)} | {change} | {recent_text} | {recent_change} | "
               f"{row['startup_ms']} | "
               f"{row['nvim_rss_mib']} | {row['python_rss_mib']} |")
  out += ["", END]
  return "\n".join(out)


def update_syntax(block):
  text = SYNTAX.read_text()
  if START in text and END in text:
    text = text[:text.index(START)] + block + text[text.index(END) + len(END):]
  else:
    anchor = "## Neovim treesitter filetypes not in bat"
    section = "## Markdown rendering benchmarks\n\n" + block + "\n\n"
    text = text.replace(anchor, section + anchor, 1) if anchor in text else text + "\n" + section
  SYNTAX.write_text(text)


def main():
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--runs", type=int, default=3, help="Measured runs per sample and mode (default: 3)")
  parser.add_argument("--max-load", type=float, default=max(1.0, (os.cpu_count() or 1) * 0.6),
                      help="Highest 1-minute load average to start at (default: 0.6 x CPUs)")
  parser.add_argument("--max-wait", type=float, default=900, help="Seconds to wait for the load (default: 900)")
  parser.add_argument("--interval", type=float, default=15, help="Seconds between load checks (default: 15)")
  parser.add_argument("--timeout", type=int, default=60, help="nvcat --timeout per render (default: 60)")
  parser.add_argument("--dry-run", action="store_true", help="Print the table without recording anything")
  parser.add_argument("--record-noisy", action="store_true",
                      help="Record a run even when it looks noisy (for a startup that really changed)")
  args = parser.parse_args()
  if not wait_for_load(args.max_load, args.max_wait, args.interval):
    print(f"benchmark: load stayed above {args.max_load:.2f} for {args.max_wait:.0f}s; nothing recorded",
          file=sys.stderr)
    return 2
  base = dict(metadata(), runs=args.runs)
  pairs = [(sample, mode) for sample in SAMPLES for mode in [*MODES, *WORKER_MODES]]
  rows = []
  with Worker() as worker:
    def either(sample, mode, timeout):
      return worker_render(worker, sample, mode) if mode in WORKER_MODES else render(sample, mode, timeout)
    results = measure(pairs, args.runs, args.timeout, render=either)
    all_served(worker.stats(), (args.runs + 1) * len(SAMPLES) * len(WORKER_MODES))
  for (sample, mode), result in results.items():
    rows.append(dict(base, sample=sample, mode=mode, **result))
    print(f"{sample:7} {mode:9} {result['median_ms']:7d} ms  startup {result['startup_ms']:4d} ms  "
          f"nvim {result['nvim_rss_mib']:4d} MiB", file=sys.stderr, flush=True)
  previous = read_history()
  block = table(rows, previous)
  if args.dry_run:
    print(block)
    return 0
  reason = noise(rows, previous, load1(), args.max_load)
  if reason and not args.record_noisy:
    print(block)
    print(f"benchmark: noisy, not recorded: {reason}; rerun when the machine is quiet, or pass --record-noisy",
          file=sys.stderr)
    return 3
  append_history(rows)
  update_syntax(block)
  print(block)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
